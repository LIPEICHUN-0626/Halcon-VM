                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="选中 ROI 图层">
                                <StackPanel>
                                    <TextBlock x:Name="RoiSelectedLayerText" Text="未选择 ROI 图层" FontWeight="SemiBold" Foreground="#334155" Margin="4" />
                                     <Grid>
                                         <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                         <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                         <TextBlock Text="名称" VerticalAlignment="Center" />
                                         <TextBox x:Name="SelectedRoiLayerNameTextBox" Grid.Column="1" IsEnabled="False" LostFocus="SelectedRoiLayerNameTextBox_LostFocus" />
                                         <TextBlock Grid.Row="1" Text="几何" VerticalAlignment="Center" />
                                         <TextBlock x:Name="SelectedRoiGeometryText" Grid.Row="1" Grid.Column="1" Text="--" Foreground="#64748B" TextWrapping="Wrap" />
                                         <TextBlock Grid.Row="2" Text="保护" VerticalAlignment="Center" />
                                         <CheckBox x:Name="SelectedRoiLockCheckBox" Grid.Row="2" Grid.Column="1" Content="锁定几何与删除" IsEnabled="False" Click="SelectedRoiLockCheckBox_Click" />
                                         <TextBlock Grid.Row="3" Text="角色" VerticalAlignment="Center" />
                                         <TextBlock x:Name="SelectedRoiRoleText" Grid.Row="3" Grid.Column="1" Text="--" Foreground="#BE123C" FontWeight="SemiBold" />
                                     </Grid>
                                     <UniformGrid Columns="4">
                                         <Button x:Name="CopySelectedRoiButton" Content="复制" Click="CopySelectedRoiButton_Click" />
                                         <Button x:Name="ToggleSelectedRoiLockButton" Content="锁定" Click="ToggleSelectedRoiLockButton_Click" />
                                         <Button x:Name="ClearRoiButton" Content="删除选中" Click="ClearRoiButton_Click" />
                                         <Button x:Name="ClearAllRoiLayersButton" Content="清空全部" Click="ClearAllRoiLayersButton_Click" />
                                     </UniformGrid>
                                     <UniformGrid Columns="3">
                                         <Button x:Name="ToggleSelectedRoiRoleButton" Content="设为屏蔽区" Click="ToggleSelectedRoiRoleButton_Click" ToolTip="矩形、圆形、多边形、旋转矩形、椭圆和圆环可作为屏蔽区；线和点不支持" />
                                         <Button x:Name="MoveSelectedRoiUpButton" Content="上移" Click="MoveSelectedRoiUpButton_Click" />
                                         <Button x:Name="MoveSelectedRoiDownButton" Content="下移" Click="MoveSelectedRoiDownButton_Click" />
                                     </UniformGrid>
                                     <TextBlock x:Name="RoiEditGuidanceText" Text="选择模式：单击 ROI 后拖动内部移动，拖动控制点编辑几何。" Foreground="#0F766E" TextWrapping="Wrap" Margin="4" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="ROI 几何属性（草稿）">
                                <StackPanel>
                                    <TextBlock x:Name="RoiGeometryDraftShapeText" Text="选择一个 ROI 后可精确编辑几何参数" FontWeight="SemiBold" Foreground="#334155" Margin="4" TextWrapping="Wrap" />
                                    <StackPanel x:Name="RoiRectangleGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="中心 X（列）" /><TextBox x:Name="RoiRectangleCenterXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="中心 Y（行）" /><TextBox x:Name="RoiRectangleCenterYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="宽度" /><TextBox x:Name="RoiRectangleWidthTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="高度" /><TextBox x:Name="RoiRectangleHeightTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiCircleGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="中心 X（列）" /><TextBox x:Name="RoiCircleCenterXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="中心 Y（行）" /><TextBox x:Name="RoiCircleCenterYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="直径" /><TextBox x:Name="RoiCircleDiameterTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiOrientedGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="中心 X（列）" /><TextBox x:Name="RoiOrientedCenterXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="中心 Y（行）" /><TextBox x:Name="RoiOrientedCenterYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock x:Name="RoiOrientedLength1Label" Text="宽度" /><TextBox x:Name="RoiOrientedLength1TextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock x:Name="RoiOrientedLength2Label" Text="高度" /><TextBox x:Name="RoiOrientedLength2TextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="角度（°）" /><TextBox x:Name="RoiOrientedAngleTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiAnnulusGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="中心 X（列）" /><TextBox x:Name="RoiAnnulusCenterXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="中心 Y（行）" /><TextBox x:Name="RoiAnnulusCenterYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="内径" /><TextBox x:Name="RoiAnnulusInnerDiameterTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="外径" /><TextBox x:Name="RoiAnnulusOuterDiameterTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiLineGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="起点 X（列）" /><TextBox x:Name="RoiLineStartXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="起点 Y（行）" /><TextBox x:Name="RoiLineStartYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="终点 X（列）" /><TextBox x:Name="RoiLineEndXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="终点 Y（行）" /><TextBox x:Name="RoiLineEndYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="长度（只读）" /><TextBox x:Name="RoiLineLengthTextBox" IsReadOnly="True" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="角度（°，只读）" /><TextBox x:Name="RoiLineAngleTextBox" IsReadOnly="True" ToolTip="以图像 X 正方向为 0°，逆时针为正" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiPointGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="X（列）" /><TextBox x:Name="RoiPointXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Y（行）" /><TextBox x:Name="RoiPointYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiPolygonGeometryPanel" Visibility="Collapsed">
                                        <TextBlock Text="顶点 X,Y（每行一个；X=列，Y=行）" />
                                        <TextBox x:Name="RoiPolygonVerticesTextBox" MinHeight="76" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="RoiGeometryDraftValue_Changed" />
                                    </StackPanel>
                                    <TextBlock x:Name="RoiGeometryDraftStatusText" Text="选择 ROI 后显示可编辑参数。" Foreground="#64748B" Margin="4" TextWrapping="Wrap" />
                                    <UniformGrid Columns="3">
                                        <Button x:Name="ApplyRoiGeometryDraftButton" Content="应用" IsEnabled="False" Click="ApplyRoiGeometryDraftButton_Click" />
                                        <Button x:Name="CancelRoiGeometryDraftButton" Content="取消" IsEnabled="False" Click="CancelRoiGeometryDraftButton_Click" />
                                        <Button x:Name="ReloadRoiGeometryDraftButton" Content="从图像重载" IsEnabled="False" Click="ReloadRoiGeometryDraftButton_Click" />
                                    </UniformGrid>
                                    <TextBlock Text="输入会在图像区实时预览；只有“应用”才写入配方。锁定 ROI 只读。" Foreground="#64748B" FontSize="10" Margin="4" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="绑定到当前工具">
                                <StackPanel>
                                    <TextBlock x:Name="RoiBindingToolText" Text="请先选择流程中的视觉工具" FontWeight="SemiBold" Foreground="#475569" TextWrapping="Wrap" Margin="4" />
                                    <ItemsControl x:Name="RoiBindingItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsBound}" VerticalAlignment="Center" Margin="2,0,8,0" Checked="RoiBindingCheckBox_Changed" Unchecked="RoiBindingCheckBox_Changed" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ShapeText}" Foreground="#64748B" FontSize="10" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="#0F766E" FontSize="10" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="RoiBindingsStatusText" Text="绑定后按当前模块的 ROI 执行模式运行。" Foreground="#64748B" TextWrapping="Wrap" Margin="4" />
                                    <Button Content="运行当前工具验证 ROI" FontWeight="SemiBold" Foreground="#0F766E" Click="RunCurrentToolButton_Click" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="模板快捷入口">
                                <StackPanel>
                                    <Button Content="选择 Shape 工具并打开参数" Click="SelectShapeToolButton_Click" />
                                    <TextBlock Text="主要模板参数保留在 Shape Inspector；搜索区域由该工具绑定的 ROI 图层提供。" Foreground="#64748B" TextWrapping="Wrap" Margin="4" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="LayerWorkspaceTab" Header="图层" ToolTip="ROI、屏蔽区与结果图层的当前任务区">
                    <Grid x:Name="RightLayerTaskHost" Background="#111827" />
                </TabItem>

                <TabItem x:Name="CommunicationWorkspaceTab" Header="通讯" ToolTip="设备/通讯">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="9">
                            <GroupBox Header="TCP 通讯">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="TcpClientModeRadio" Content="TCP客户端" IsChecked="True" HorizontalContentAlignment="Center" Checked="TcpModeChanged" />
                                        <RadioButton x:Name="TcpServerModeRadio" Content="TCP服务端" HorizontalContentAlignment="Center" Checked="TcpModeChanged" />
                                    </UniformGrid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock x:Name="TcpIpLabel" Text="远端IP" VerticalAlignment="Center" /><TextBox x:Name="TcpIpTextBox" Grid.Column="1" Text="127.0.0.1" />
                                        <TextBlock Grid.Column="2" Text="端口" VerticalAlignment="Center" /><TextBox x:Name="TcpPortTextBox" Grid.Column="3" Text="9000" />
                                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="4">
                                            <Button x:Name="TcpConnectButton" Content="连接" Click="TcpConnectButton_Click" /><Button x:Name="TcpDisconnectButton" Content="断开" Click="TcpDisconnectButton_Click" />
                                            <Button x:Name="TcpStartServerButton" Content="启动监听" Click="TcpStartServerButton_Click" /><Button x:Name="TcpStopServerButton" Content="停止监听" Click="TcpStopServerButton_Click" />
                                        </WrapPanel>
                                    </Grid>
                                    <WrapPanel>
                                        <TextBlock Text="编码" VerticalAlignment="Center" Margin="4" />
                                        <ComboBox x:Name="TcpEncodingCombo" Width="92" SelectedIndex="0"><ComboBoxItem Content="UTF-8" /><ComboBoxItem Content="ASCII" /><ComboBoxItem Content="GBK" /></ComboBox>
                                        <CheckBox x:Name="TcpAppendNewLineCheckBox" Content="追加换行" IsChecked="True" Margin="8,4" />
                                        <CheckBox x:Name="AutoSendMatchResultCheckBox" Content="自动发送结果" IsChecked="True" Margin="8,4" />
                                    </WrapPanel>
                                    <TextBlock x:Name="TcpStatusText" Text="未连接，发送不可用" TextWrapping="Wrap" Foreground="#475569" Margin="4" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="手动测试">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBox x:Name="TcpSendTextBox" Text="Hello" AcceptsReturn="True" Height="65" VerticalScrollBarVisibility="Auto" />
                                    <Button x:Name="TcpSendButton" Grid.Column="1" Content="发送文本" FontWeight="Bold" Click="TcpSendButton_Click" />
                                    <Button x:Name="SendLastMatchButton" Grid.Row="1" Grid.ColumnSpan="2" Content="发送最新流程结果" FontWeight="Bold" Click="SendLastMatchButton_Click" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="ProjectDiagnosticsTab" Header="方案" ToolTip="方案/配方/诊断">
                    <TabControl x:Name="RecipeWorkspaceTabs" Margin="5">
                        <TabItem Header="当前">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <Border x:Name="RecipeWorkspaceStatusBorder" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                        <TextBlock x:Name="RecipeWorkspaceStatusText" Text="新方案尚未保存" Foreground="#9A3412" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="方案名称" VerticalAlignment="Center" /><TextBox x:Name="RecipeNameEditTextBox" Grid.Column="1" Text="DefaultRecipe" />
                                        <TextBlock Grid.Row="1" Text="正式路径" VerticalAlignment="Top" Margin="0,7,0,0" /><TextBlock x:Name="RecipePathText" Grid.Row="1" Grid.Column="1" Text="--" TextWrapping="Wrap" Foreground="#475569" Margin="4,7" />
                                        <TextBlock Grid.Row="2" Text="格式版本" VerticalAlignment="Center" /><TextBlock x:Name="RecipeSchemaText" Grid.Row="2" Grid.Column="1" Text="v2" Foreground="#0F766E" Margin="4" />
                                        <TextBlock Grid.Row="3" Text="最近保存" VerticalAlignment="Center" /><TextBlock x:Name="RecipeSavedAtText" Grid.Row="3" Grid.Column="1" Text="--" Foreground="#64748B" Margin="4" />
                                    </Grid>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button Content="新建" Click="NewRecipeButton_Click" /><Button Content="打开" Click="LoadRecipeButton_Click" />
                                        <Button Content="保存" FontWeight="SemiBold" Foreground="#0F766E" Click="SaveRecipeButton_Click" /><Button Content="另存为" Click="SaveRecipeAsButton_Click" />
                                    </WrapPanel>
                                    <WrapPanel><Button Content="打开方案目录" Click="OpenRecipeDirectoryButton_Click" /><Button Content="打开日志目录" Click="OpenLogDirectoryButton_Click" /></WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="最近">
                            <Grid Margin="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="双击即可打开最近方案；不存在的文件会明确标记。" Foreground="#475569" TextWrapping="Wrap" Margin="2,0,2,6" />
                                <ListBox x:Name="RecentRecipeList" Grid.Row="1" HorizontalContentAlignment="Stretch" MouseDoubleClick="RecentRecipeList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="7,5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DirectoryText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                    <TextBlock Text="{Binding StateText}" Foreground="#0F766E" FontSize="10" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Grid.Row="2"><Button Content="打开所选" Click="OpenRecentRecipeButton_Click" /><Button Content="移除记录" Click="RemoveRecentRecipeButton_Click" /></WrapPanel>
                            </Grid>
                        </TabItem>
                        <TabItem Header="恢复">
                            <StackPanel Margin="10">
                                <TextBlock Text="异常退出时，未保存修改只写入独立恢复副本，不会覆盖正式方案。" Foreground="#475569" TextWrapping="Wrap" Margin="2,0,2,8" />
                                <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="4" Padding="9">
                                    <TextBlock x:Name="RecoveryStatusText" Text="当前没有待恢复的方案。" Foreground="#9A3412" TextWrapping="Wrap" />
                                </Border>
                                <WrapPanel Margin="0,8,0,0"><Button x:Name="RecoverRecipeButton" Content="恢复副本" IsEnabled="False" Click="RecoverRecipeButton_Click" /><Button x:Name="DiscardRecoveryButton" Content="忽略并删除" IsEnabled="False" Click="DiscardRecoveryButton_Click" /></WrapPanel>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="自检">
                            <DataGrid x:Name="DiagnosticsDataGrid" Margin="7" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="项目" Binding="{Binding Name}" Width="125" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="55" />
                                    <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </TabItem>
                </TabControl>
            </Grid>

            <Border x:Name="ProductionRunPanel" Grid.Column="4" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#101827" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="5" Padding="10" Panel.ZIndex="30">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="ProductionWidgetStack">
                    <Border x:Name="ProductionSchemeWidget" Background="#1E3A5F" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="5" Padding="11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ProductionSchemeWidgetTitleText" Text="生产运行" Foreground="White" FontSize="19" FontWeight="Bold" />
                                <TextBlock x:Name="ProductionSchemeText" Text="方案：未加载" Foreground="#BFDBFE" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ProductionModeStateText" Text="真实执行器 · 待命" Foreground="#93C5FD" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="返回开发" MinWidth="76" Click="ToggleProductionModeButton_Click" Tag="Developer" />
                        </Grid>

                                                            <DataTrigger Binding="{Binding StateKey}" Value="Error"><Setter TargetName="InputPortChip" Property="Background" Value="#FEF2F2" /><Setter TargetName="InputPortChip" Property="BorderBrush" Value="#DC2626" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPortSelected}" Value="True"><Setter TargetName="InputPortChip" Property="Background" Value="#EDE9FE" /><Setter TargetName="InputPortChip" Property="BorderBrush" Value="#7C3AED" /><Setter TargetName="InputPortChip" Property="BorderThickness" Value="2" /></DataTrigger>

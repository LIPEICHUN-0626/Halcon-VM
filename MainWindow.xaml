                                                     <TextBlock Grid.Row="1" Text="模板宽" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageFilterWidthTextBox" Grid.Row="1" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="均值滤波：3 到 255 的奇数" />
                                                     <TextBlock Grid.Row="1" Grid.Column="2" Text="模板高" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageFilterHeightTextBox" Grid.Row="1" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="均值滤波：3 到 255 的奇数" />
                                                     <TextBlock Grid.Row="2" Text="中值半径" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageFilterRadiusTextBox" Grid.Row="2" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="中值滤波：1 到 100" />
                                                     <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="均值使用宽×高；中值使用圆形半径" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>
                                         <StackPanel x:Name="DockImageEnhancementPanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 图像增强">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="增强模式" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockImageEnhancementModeComboBox" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="1" Text="灰度增益" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementScaleTextBox" Grid.Row="1" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="线性灰度缩放：0.01 到 10" />
                                                     <TextBlock Grid.Row="1" Grid.Column="2" Text="灰度偏移" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementOffsetTextBox" Grid.Row="1" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="线性灰度缩放：-255 到 255" />
                                                     <TextBlock Grid.Row="2" Text="局部模板宽" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementMaskWidthTextBox" Grid.Row="2" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="局部增强：3 到 255 的奇数" />
                                                     <TextBlock Grid.Row="2" Grid.Column="2" Text="模板高" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementMaskHeightTextBox" Grid.Row="2" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="局部增强：3 到 255 的奇数" />
                                                     <TextBlock Grid.Row="3" Text="增强因子" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementFactorTextBox" Grid.Row="3" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="局部增强：大于 0 且不超过 20" />
                                                     <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="线性模式使用增益/偏移；局部模式使用模板与因子。" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>
                                         <StackPanel x:Name="DockImageResizePanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 图像尺寸缩放">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="目标宽度" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageResizeWidthTextBox" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="2 到 16384 像素" />
                                                     <TextBlock Grid.Column="2" Text="目标高度" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageResizeHeightTextBox" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="2 到 16384 像素" />
                                                     <TextBlock Grid.Row="1" Text="插值方式" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockImageResizeInterpolationComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <Border Grid.Row="2" Grid.ColumnSpan="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,7,0,0">
                                                         <TextBlock Text="执行 HALCON zoom_image_size。输出 ScaleRow=目标高度/输入高度、ScaleColumn=目标宽度/输入宽度；按完整图像矩形采样并忽略输入 domain，输出恢复完整矩形 domain，缩放结果使用新的像素坐标系。" Foreground="#1E3A8A" TextWrapping="Wrap" />
                                                     </Border>
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>
                                         <StackPanel x:Name="DockImageMirrorPanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 图像镜像">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="镜像方向" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockImageMirrorModeComboBox" Grid.Column="1" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#ECFEFF" BorderBrush="#A5F3FC" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,7,0,0">
                                                         <TextBlock Text="执行 HALCON mirror_image：row 上下翻转，column 左右翻转，diagonal 沿主对角线转置；非方形图像使用 diagonal 时输出宽高互换。镜像后的模块输出使用新坐标语义，输入 ROI 不会误叠加。" Foreground="#155E75" TextWrapping="Wrap" />
                                                     </Border>
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>
                                          <StackPanel x:Name="DockImageRotatePanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 图像旋转">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="逆时针角度" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageRotateAngleTextBox" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="0 到 360 度；围绕图像中心逆时针旋转" />
                                                     <TextBlock Grid.Column="2" Text="插值方式" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockImageRotateInterpolationComboBox" Grid.Column="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,7,0,0">
                                                         <TextBlock Text="执行 HALCON rotate_image：围绕图像中心逆时针旋转。90°/270°交换输出宽高，其他角度保持矩阵尺寸；算子忽略输入 domain，并把变换后图像矩形与输出矩形的交集作为输出 domain。旋转结果使用新的像素坐标系。" Foreground="#5B21B6" TextWrapping="Wrap" />
                                                     </Border>
                                                 </Grid>
                                              </GroupBox>
                                          </StackPanel>
                                          <StackPanel x:Name="DockImageAffineTransformPanel" Visibility="Collapsed">
                                              <GroupBox Header="HALCON 仿射图像变换">
                                                  <Grid>
                                                      <Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                      <TextBlock Text="平移 Row" VerticalAlignment="Center" />
                                                      <TextBox x:Name="DockImageAffineTranslateRowTextBox" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="正值向下平移，负值向上平移" />
                                                      <TextBlock Grid.Column="2" Text="平移 Column" VerticalAlignment="Center" />
                                                      <TextBox x:Name="DockImageAffineTranslateColumnTextBox" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="正值向右平移，负值向左平移" />
                                                      <TextBlock Grid.Row="1" Text="行缩放" VerticalAlignment="Center" />
                                                      <TextBox x:Name="DockImageAffineScaleRowTextBox" Grid.Row="1" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="0.001 到 100；围绕图像中心缩放" />
                                                      <TextBlock Grid.Row="1" Grid.Column="2" Text="列缩放" VerticalAlignment="Center" />
                                                      <TextBox x:Name="DockImageAffineScaleColumnTextBox" Grid.Row="1" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="0.001 到 100；围绕图像中心缩放" />
                                                      <TextBlock Grid.Row="2" Text="旋转角(°)" VerticalAlignment="Center" />
                                                      <TextBox x:Name="DockImageAffineRotationTextBox" Grid.Row="2" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="-360 到 360；在 HALCON 行列右手坐标中围绕图像中心旋转" />
                                                      <TextBlock Grid.Row="2" Grid.Column="2" Text="行斜切(°)" VerticalAlignment="Center" />
                                                      <TextBox x:Name="DockImageAffineSlantTextBox" Grid.Row="2" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="严格位于 -80 到 80；固定 Column 轴，对 Row 轴执行斜切" />
                                                      <TextBlock Grid.Row="3" Text="插值方式" VerticalAlignment="Center" />
                                                      <ComboBox x:Name="DockImageAffineInterpolationComboBox" Grid.Row="3" Grid.Column="1" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                      <CheckBox x:Name="DockImageAffineAdaptSizeCheckBox" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Content="自适应输出尺寸" VerticalAlignment="Center" Click="DockDraftValue_Changed" ToolTip="开启后由 affine_trans_image 扩展输出矩阵以容纳变换后的图像右/下边界；负坐标仍会被裁剪" />

                                                      <Border Background="#ECFEFF" BorderBrush="#67E8F9" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,0,0,7">
                                                          <StackPanel>
                                                              <WrapPanel>
                                                                  <ToggleButton x:Name="DockProjectiveImageEditToggleButton" Content="在图像中编辑四点" MinWidth="132" Click="DockProjectiveImageEditToggleButton_Click" />
                                                                  <Button Content="恢复源/目标四角" Margin="6,0,0,0" Click="DockProjectiveResetCornersButton_Click" />
                                                                  <Button Content="源点复制到目标" Margin="6,0,0,0" Click="DockProjectiveCopySourceToTargetButton_Click" />
                                                              </WrapPanel>
                                                              <TextBlock Text="左画面：源四边形（输入坐标）  ·  右画面：目标四边形（输出坐标）  ·  拖动 1–4 号控制点只修改草稿" Foreground="#155E75" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                              <TextBlock x:Name="DockProjectiveGeometryStatusText" Text="图像编辑未开启" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                          </StackPanel>
                                                      </Border>
                                                      <Grid>
                                                          <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                          <TextBlock Text="#" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="源 Row" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="源 Column" FontWeight="SemiBold" /><TextBlock Grid.Column="5" Text="目标 Row" FontWeight="SemiBold" /><TextBlock Grid.Column="7" Text="目标 Column" FontWeight="SemiBold" />

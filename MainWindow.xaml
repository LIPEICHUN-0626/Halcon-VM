                                                </StackPanel>
                                                <Button x:Name="DockAdvancedParameterToggleButton" Grid.Column="1" Content="更多参数" MinWidth="92" MinHeight="24" Padding="8,3" Click="DockAdvancedParameterToggleButton_Click" />
                                            </Grid>
                                        </Border>
                                        <StackPanel x:Name="DockImageSourcePanel" Visibility="Collapsed">
                                            <GroupBox Header="本地图像源">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Text="图像文件" VerticalAlignment="Center" />

                                                                <TextBlock Text="{Binding ObjectText}" Foreground="#CBD5E1" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock x:Name="ResultLayerStateText" Text="{Binding StateText}" Foreground="#94A3B8" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="#334155" CornerRadius="8" Padding="5,2" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding ResultCode}" Foreground="#F8FAFC" FontSize="9" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding StateKey}" Value="Valid"><Setter TargetName="ResultLayerCard" Property="BorderBrush" Value="#22C55E" /><Setter TargetName="ResultLayerStateText" Property="Foreground" Value="#86EFAC" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding StateKey}" Value="Invalid"><Setter TargetName="ResultLayerCard" Property="BorderBrush" Value="#EF4444" /><Setter TargetName="ResultLayerStateText" Property="Foreground" Value="#FCA5A5" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter TargetName="ResultLayerCard" Property="Opacity" Value="0.58" /></DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <UniformGrid Grid.Row="2" Columns="7" Margin="0,4,0,0" ToolTip="这些操作只改变显示，不释放输出或修改连接">
                                            <Button Content="全显" MinWidth="0" Padding="2,3" FontSize="10" Click="ShowAllResultLayersButton_Click" ToolTip="显示全部结果图层" />
                                            <Button Content="独显" MinWidth="0" Padding="2,3" FontSize="10" Click="IsolateResultLayerButton_Click" ToolTip="只显示选中结果图层" />
                                            <Button Content="全隐" MinWidth="0" Padding="2,3" FontSize="10" Click="HideAllResultLayersButton_Click" ToolTip="隐藏全部图层；输出保留" />
                                            <Button Content="↑" MinWidth="0" Padding="2,3" FontSize="10" Click="MoveResultLayerUpButton_Click" ToolTip="上移到更高显示层级" />
                                            <Button Content="↓" MinWidth="0" Padding="2,3" FontSize="10" Click="MoveResultLayerDownButton_Click" ToolTip="下移显示层级" />
                                            <Button Content="定位" MinWidth="0" Padding="2,3" FontSize="10" Click="LocateResultLayerProducerButton_Click" ToolTip="定位来源模块" />
                                            <Button Content="配置" MinWidth="0" Padding="2,3" FontSize="10" Click="OpenResultLayerConfigurationButton_Click" ToolTip="打开来源模块配置" />
                                        </UniformGrid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="#182235" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="7,4">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="OverlayStatusText" Foreground="#FDE68A" Text="结果：无可用叠加" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                            <TextBlock x:Name="RoiOverlayLegendText" Grid.Column="1" Foreground="#67E8F9" Text="ROI：0 个" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                            <TextBlock x:Name="ImagePixelStatusText" Grid.Column="2" Foreground="#FDE68A" Text="像素：--" Margin="12,0,0,0" />
                            <TextBlock x:Name="HeaderStatusText" Grid.Column="3" Foreground="#A7F3D0" Text="就绪" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="4" Grid.Row="1" Height="5" Background="#CBD5E1" HorizontalAlignment="Stretch" />

            <!-- Selected tool inspector and retained device/project entries -->
            <TabControl Grid.Column="4" Grid.Row="2" x:Name="RightTabs" SelectionChanged="RightTabs_SelectionChanged">
                <TabItem x:Name="ModuleResultTab" Header="模块结果">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="9">
                            <Border Background="#263449" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="FlowRunStatusText" Text="流程待命" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="FlowRunRangeText" Text="范围：--" Foreground="#BFDBFE" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#0F766E" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock x:Name="FlowRunResultText" Text="--" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                            <GroupBox Header="本次流程运行">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="总耗时" /><TextBlock x:Name="FlowRunElapsedText" Grid.Column="1" Text="--" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="停止原因" /><TextBlock x:Name="FlowStopReasonText" Grid.Row="1" Grid.Column="1" Text="--" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="当前工具" /><TextBlock x:Name="FlowCurrentToolText" Grid.Row="2" Grid.Column="1" Text="--" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Text="安全边界" /><TextBlock Grid.Row="3" Grid.Column="1" Text="暂停、停止和超时在工具步骤之间生效" Foreground="#64748B" TextWrapping="Wrap" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="选中模块结果">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="模块" /><TextBlock x:Name="SelectedResultToolText" Grid.Column="1" Text="--" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="状态" /><TextBlock x:Name="SelectedResultStatusText" Grid.Row="1" Grid.Column="1" Text="--" />
                                    <TextBlock Grid.Row="2" Text="输出" /><TextBlock x:Name="SelectedResultOutputText" Grid.Row="2" Grid.Column="1" Text="--" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Text="错误" /><TextBlock x:Name="SelectedResultErrorText" Grid.Row="3" Grid.Column="1" Text="--" Foreground="#B91C1C" TextWrapping="Wrap" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="逐 ROI 结果">
                                <DataGrid x:Name="SelectedRoiResultsDataGrid" Height="145" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ROI" Binding="{Binding RoiName}" Width="90" />
                                        <DataGridTextColumn Header="判定" Binding="{Binding ResultCode}" Width="55" />
                                        <DataGridTextColumn Header="数值" Binding="{Binding ValueText}" Width="110" />
                                        <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="65" />
                                        <DataGridTextColumn Header="说明" Binding="{Binding DisplayMessage}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <UniformGrid Columns="4">
                                <Button Content="当前" Click="RunCurrentToolButton_Click" />
                                <Button Content="到此" Click="RunToHereButton_Click" />
                                <Button Content="从此" Click="RunFromHereButton_Click" />
                                <Button Content="全流程" Foreground="#0F766E" FontWeight="SemiBold" Click="RunOnceButton_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="DockConfigurationTab" Header="模块配置" ToolTip="常驻模块配置工作台">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Background="#263449" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DockModuleTitleText" Text="请选择流程模块" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DockModuleTypeText" Text="右侧常驻配置，不打开主要参数弹窗" Foreground="#BFDBFE" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#0F766E" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockDraftStateText" Text="无草稿" Foreground="White" FontWeight="SemiBold" />
                                </Border>
                                <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="DockRevertButton" Content="撤销草稿" MinWidth="68" MinHeight="25" Click="DockRevertButton_Click" />
                                        <Button x:Name="DockApplyButton" Content="应用" MinWidth="62" MinHeight="25" Foreground="#34D399" FontWeight="SemiBold" Click="DockApplyButton_Click" />
                                    </StackPanel>
                                    <Button x:Name="DockTrialRunButton" DockPanel.Dock="Left" Content="▶ 试运行" MinWidth="72" MinHeight="25" Click="DockTrialRunButton_Click" />
                                    <TextBlock x:Name="DockFooterText" Text="选择模块开始配置" VerticalAlignment="Center" Foreground="#CBD5E1" Margin="8,0" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Grid>
                        </Border>
                        <TabControl x:Name="DockConfigurationTabs" Grid.Row="1" Margin="6">
                            <TabItem Header="基本参数">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="9">
                                        <GroupBox Header="实例">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="实例名称" VerticalAlignment="Center" />
                                                <TextBox x:Name="DockInstanceNameTextBox" Grid.Column="1" TextChanged="DockDraftValue_Changed" />
                                            </Grid>
                                        </GroupBox>
                                        <TextBlock x:Name="DockEmptyText" Text="从中央流程选择一个模块后即可配置。" Foreground="#64748B" TextWrapping="Wrap" Margin="4,6" />
                                        <StackPanel x:Name="DockImageSourcePanel" Visibility="Collapsed">
                                            <GroupBox Header="本地图像源">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Text="图像文件" VerticalAlignment="Center" />
                                                    <TextBox x:Name="DockLocalImagePathTextBox" Grid.Column="1" TextChanged="DockDraftValue_Changed" />
                                                    <Button Grid.Column="2" Content="选择" Click="DockBrowseLocalImageButton_Click" />
                                                    <TextBlock Grid.Row="1" Text="图像 SN" VerticalAlignment="Center" />
                                                    <TextBox x:Name="DockLocalImageSerialTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" TextChanged="DockDraftValue_Changed" />
                                                </Grid>
                                            </GroupBox>
                                        </StackPanel>
                                         <StackPanel x:Name="DockImageChannelPanel" Visibility="Collapsed">
                                            <GroupBox Header="HALCON 图像通道">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Text="处理模式" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="DockImageChannelModeComboBox" Grid.Column="1" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                    <TextBlock Grid.Row="1" Text="通道序号" VerticalAlignment="Center" />
                                                    <TextBox x:Name="DockImageChannelIndexTextBox" Grid.Row="1" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="仅提取指定通道时生效，从 1 开始" />
                                                </Grid>
                                            </GroupBox>
                                         </StackPanel>
                                         <StackPanel x:Name="DockImageFilterPanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 图像滤波">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="滤波模式" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockImageFilterModeComboBox" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="1" Text="模板宽" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageFilterWidthTextBox" Grid.Row="1" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="均值滤波：3 到 255 的奇数" />
                                                     <TextBlock Grid.Row="1" Grid.Column="2" Text="模板高" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageFilterHeightTextBox" Grid.Row="1" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="均值滤波：3 到 255 的奇数" />
                                                     <TextBlock Grid.Row="2" Text="中值半径" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageFilterRadiusTextBox" Grid.Row="2" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="中值滤波：1 到 100" />
                                                     <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="均值使用宽×高；中值使用圆形半径" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>
                                         <StackPanel x:Name="DockImageEnhancementPanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 图像增强">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="增强模式" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockImageEnhancementModeComboBox" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="1" Text="灰度增益" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementScaleTextBox" Grid.Row="1" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="线性灰度缩放：0.01 到 10" />
                                                     <TextBlock Grid.Row="1" Grid.Column="2" Text="灰度偏移" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementOffsetTextBox" Grid.Row="1" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="线性灰度缩放：-255 到 255" />
                                                     <TextBlock Grid.Row="2" Text="局部模板宽" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementMaskWidthTextBox" Grid.Row="2" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="局部增强：3 到 255 的奇数" />
                                                     <TextBlock Grid.Row="2" Grid.Column="2" Text="模板高" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementMaskHeightTextBox" Grid.Row="2" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="局部增强：3 到 255 的奇数" />
                                                     <TextBlock Grid.Row="3" Text="增强因子" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageEnhancementFactorTextBox" Grid.Row="3" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="局部增强：大于 0 且不超过 20" />
                                                     <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Text="线性模式使用增益/偏移；局部模式使用模板与因子。" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>
                                         <StackPanel x:Name="DockImageResizePanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 图像尺寸缩放">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="目标宽度" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageResizeWidthTextBox" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="2 到 16384 像素" />
                                                     <TextBlock Grid.Column="2" Text="目标高度" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageResizeHeightTextBox" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="2 到 16384 像素" />
                                                     <TextBlock Grid.Row="1" Text="插值方式" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockImageResizeInterpolationComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <Border Grid.Row="2" Grid.ColumnSpan="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,7,0,0">
                                                         <TextBlock Text="执行 HALCON zoom_image_size。输出 ScaleRow=目标高度/输入高度、ScaleColumn=目标宽度/输入宽度；按完整图像矩形采样并忽略输入 domain，输出恢复完整矩形 domain，缩放结果使用新的像素坐标系。" Foreground="#1E3A8A" TextWrapping="Wrap" />
                                                     </Border>
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>
                                         <StackPanel x:Name="DockImageMirrorPanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 图像镜像">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="镜像方向" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockImageMirrorModeComboBox" Grid.Column="1" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#ECFEFF" BorderBrush="#A5F3FC" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,7,0,0">
                                                         <TextBlock Text="执行 HALCON mirror_image：row 上下翻转，column 左右翻转，diagonal 沿主对角线转置；非方形图像使用 diagonal 时输出宽高互换。镜像后的模块输出使用新坐标语义，输入 ROI 不会误叠加。" Foreground="#155E75" TextWrapping="Wrap" />
                                                     </Border>
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>
                                         <StackPanel x:Name="DockImageRotatePanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 图像旋转">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="逆时针角度" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockImageRotateAngleTextBox" Grid.Column="1" TextChanged="DockDraftValue_Changed" ToolTip="0 到 360 度；围绕图像中心逆时针旋转" />
                                                     <TextBlock Grid.Column="2" Text="插值方式" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockImageRotateInterpolationComboBox" Grid.Column="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <Border Grid.Row="1" Grid.ColumnSpan="4" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,7,0,0">
                                                         <TextBlock Text="执行 HALCON rotate_image：围绕图像中心逆时针旋转。90°/270°交换输出宽高，其他角度保持矩阵尺寸；算子忽略输入 domain，并把变换后图像矩形与输出矩形的交集作为输出 domain。旋转结果使用新的像素坐标系。" Foreground="#5B21B6" TextWrapping="Wrap" />
                                                     </Border>
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>
                                         <StackPanel x:Name="DockPolarImageUnwrapPanel" Visibility="Collapsed">
                                             <GroupBox Header="HALCON 极坐标展开">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                     <TextBlock Text="中心 Row" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockPolarCenterRowTextBox" Grid.Column="1" TextChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Column="2" Text="中心 Column" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockPolarCenterColumnTextBox" Grid.Column="3" TextChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="1" Text="起始角(°)" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockPolarStartAngleTextBox" Grid.Row="1" Grid.Column="1" TextChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="1" Grid.Column="2" Text="终止角(°)" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockPolarEndAngleTextBox" Grid.Row="1" Grid.Column="3" TextChanged="DockDraftValue_Changed" ToolTip="终止角小于起始角时按反向展开" />
                                                     <TextBlock Grid.Row="2" Text="内半径" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockPolarInnerRadiusTextBox" Grid.Row="2" Grid.Column="1" TextChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="2" Grid.Column="2" Text="外半径" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockPolarOuterRadiusTextBox" Grid.Row="2" Grid.Column="3" TextChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="3" Text="输出宽度" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockPolarOutputWidthTextBox" Grid.Row="3" Grid.Column="1" TextChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="3" Grid.Column="2" Text="输出高度" VerticalAlignment="Center" />
                                                     <TextBox x:Name="DockPolarOutputHeightTextBox" Grid.Row="3" Grid.Column="3" TextChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="4" Text="插值方式" VerticalAlignment="Center" />
                                                     <ComboBox x:Name="DockPolarInterpolationComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                     <TextBlock Grid.Row="5" Grid.ColumnSpan="4" Text="角度沿输出宽度展开，半径沿输出高度展开。整圆会自动缩短一个角度采样步，避免首列与末列重复；输出可继续驱动阈值、Blob、灰度与边缘工具。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                 </Grid>
                                             </GroupBox>
                                         </StackPanel>

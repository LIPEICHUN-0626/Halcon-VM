                                                          <TextBlock Grid.Row="2" Text="2" /><TextBox x:Name="DockProjectiveSourceRow2TextBox" Grid.Row="2" Grid.Column="2" TextChanged="DockDraftValue_Changed" /><TextBox x:Name="DockProjectiveSourceColumn2TextBox" Grid.Row="2" Grid.Column="4" TextChanged="DockDraftValue_Changed" /><TextBox x:Name="DockProjectiveTargetRow2TextBox" Grid.Row="2" Grid.Column="6" TextChanged="DockDraftValue_Changed" /><TextBox x:Name="DockProjectiveTargetColumn2TextBox" Grid.Row="2" Grid.Column="8" TextChanged="DockDraftValue_Changed" />
                                                          <TextBlock Grid.Row="3" Text="3" /><TextBox x:Name="DockProjectiveSourceRow3TextBox" Grid.Row="3" Grid.Column="2" TextChanged="DockDraftValue_Changed" /><TextBox x:Name="DockProjectiveSourceColumn3TextBox" Grid.Row="3" Grid.Column="4" TextChanged="DockDraftValue_Changed" /><TextBox x:Name="DockProjectiveTargetRow3TextBox" Grid.Row="3" Grid.Column="6" TextChanged="DockDraftValue_Changed" /><TextBox x:Name="DockProjectiveTargetColumn3TextBox" Grid.Row="3" Grid.Column="8" TextChanged="DockDraftValue_Changed" />
                                                      </Grid>
                                                      <Grid Margin="0,2,0,0">
                                                          <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                          <TextBlock Text="4" /><TextBox x:Name="DockProjectiveSourceRow4TextBox" Grid.Column="2" TextChanged="DockDraftValue_Changed" /><TextBox x:Name="DockProjectiveSourceColumn4TextBox" Grid.Column="4" TextChanged="DockDraftValue_Changed" /><TextBox x:Name="DockProjectiveTargetRow4TextBox" Grid.Column="6" TextChanged="DockDraftValue_Changed" /><TextBox x:Name="DockProjectiveTargetColumn4TextBox" Grid.Column="8" TextChanged="DockDraftValue_Changed" />
                                                      </Grid>
                                                      <Grid Margin="0,6,0,0">
                                                          <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                          <TextBlock Text="插值方式" VerticalAlignment="Center" /><ComboBox x:Name="DockProjectiveInterpolationComboBox" Grid.Column="1" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockDraftValue_Changed" />
                                                          <TextBlock Grid.Column="2" Text="输出尺寸" VerticalAlignment="Center" /><ComboBox x:Name="DockProjectiveOutputModeComboBox" Grid.Column="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="DockProjectiveOutputModeComboBox_SelectionChanged" />
                                                          <TextBlock Grid.Row="1" Text="显式宽度" VerticalAlignment="Center" /><TextBox x:Name="DockProjectiveOutputWidthTextBox" Grid.Row="1" Grid.Column="1" TextChanged="DockDraftValue_Changed" /><TextBlock Grid.Row="1" Grid.Column="2" Text="显式高度" VerticalAlignment="Center" /><TextBox x:Name="DockProjectiveOutputHeightTextBox" Grid.Row="1" Grid.Column="3" TextChanged="DockDraftValue_Changed" />

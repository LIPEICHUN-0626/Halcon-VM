                                        <TextBlock Text="颜色" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="9,0,3,0" /><ComboBox x:Name="Crosshair2ColorComboBox" Width="72" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="CrosshairSettings_Changed" />

                                                            </Grid>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding SourceText}" FontWeight="SemiBold" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceText}" />

<Window x:Class="HalconWinFormsDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="HALCON 工业视觉平台"
        MinWidth="1120"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>
        <Style x:Key="MetricCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D8DEE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style x:Key="CompactMetricUnit" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="#D8DEE9" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AppBarButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="50" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="6,1" />
        </Style>
        <Style x:Key="PanelHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,8" />
        </Style>
        <DrawingBrush x:Key="FlowGridBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F7F9FC" Geometry="M0,0 H24 V24 H0 Z" />
                    <GeometryDrawing Brush="#DDE4EE" Geometry="M23,23 H25 V25 H23 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#E9EEF5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="440" />
            <RowDefinition Height="22" />
            <RowDefinition x:Name="BottomPanelRow" Height="0" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Menu x:Name="MainMenu" Grid.Row="0" Background="#F8FAFC" BorderBrush="#D7DEE8" BorderThickness="0,0,0,1" Padding="4,1">
                    <MenuItem Header="文件">
                        <MenuItem Header="新建方案" Click="NewRecipeButton_Click" />
                        <MenuItem Header="打开方案" Click="LoadRecipeButton_Click" />
                        <MenuItem Header="保存方案" Click="SaveRecipeButton_Click" />
                        <MenuItem Header="方案另存为" Click="SaveRecipeAsButton_Click" />
                        <Separator />
                        <MenuItem Header="打开图片" Click="OpenImageButton_Click" />
                        <MenuItem Header="批量图片" Click="OpenFolderButton_Click" />
                    </MenuItem>
                    <MenuItem Header="编辑">
                        <MenuItem x:Name="UndoFlowEditMenuItem" Header="撤销流程编辑" InputGestureText="Ctrl+Z" Click="UndoFlowEditButton_Click" />
                        <MenuItem x:Name="RedoFlowEditMenuItem" Header="重做流程编辑" InputGestureText="Ctrl+Y" Click="RedoFlowEditButton_Click" />
                        <Separator />
                        <MenuItem Header="复制模块" InputGestureText="Ctrl+C" Click="CopyFlowToolButton_Click" />
                        <MenuItem Header="粘贴模块" InputGestureText="Ctrl+V" Click="PasteFlowToolButton_Click" />
                        <MenuItem Header="创建副本" Click="DuplicateFlowToolButton_Click" />
                        <Separator />
                        <MenuItem Header="创建流程组合" Click="CreateFlowGroupButton_Click" />
                        <MenuItem Header="解组" Click="UngroupFlowGroupButton_Click" />
                        <MenuItem Header="折叠组合" Click="CollapseFlowGroupButton_Click" />
                        <MenuItem Header="展开组合" Click="ExpandFlowGroupButton_Click" />
                        <MenuItem Header="应用组合名称" Click="RenameFlowGroupButton_Click" />
                    </MenuItem>
                    <MenuItem Header="运行">
                        <MenuItem Header="运行全流程" Click="RunOnceButton_Click" />
                        <MenuItem Header="运行当前" Click="RunCurrentToolButton_Click" />
                        <MenuItem Header="运行到此" Click="RunToHereButton_Click" />
                        <MenuItem Header="从此运行" Click="RunFromHereButton_Click" />
                        <Separator />
                        <MenuItem Header="单步执行" InputGestureText="F10" Click="DebugStepButton_Click" />
                        <MenuItem Header="继续调试" InputGestureText="F5" Click="DebugContinueButton_Click" />
                        <MenuItem Header="设置 / 取消所选断点" InputGestureText="F9" Click="ToggleBreakpointButton_Click" />
                        <MenuItem Header="清除全部断点" Click="ClearBreakpointsButton_Click" />
                        <Separator />
                        <MenuItem Header="连续运行" Click="RunContinuousButton_Click" />
                        <MenuItem Header="暂停 / 继续" Click="PauseRunButton_Click" />
                        <MenuItem Header="停止" Click="StopRunButton_Click" />
                    </MenuItem>
                    <MenuItem Header="视图">
                        <MenuItem Header="切换到运行界面" Click="ToggleProductionModeButton_Click" Tag="Production" ToolTip="只切换到操作员运行页面，不会自动开始检测" />
                        <Separator />
                        <MenuItem Header="流程适应窗口" Click="FitFlowButton_Click" />
                        <MenuItem Header="图像适应窗口" Click="FitImageButton_Click" />
                        <Separator />
                        <MenuItem Header="全局变量" Click="OpenGlobalVariablesButton_Click" />
                        <MenuItem Header="外部资源" Click="OpenExternalResourcesButton_Click" />
                        <MenuItem Header="脚本接口" Click="OpenScriptInterfaceButton_Click" />
                        <MenuItem Header="项目自检" Click="DiagnosticsButton_Click" />
                    </MenuItem>
                    <MenuItem x:Name="ExampleProgramsMenuS78" Header="示例程序" ToolTip="装载可编辑、可运行的真实学习方案；不会自动执行">
                        <MenuItem Header="入门 · 基础分割与区域测量" Click="LoadBasicSegmentationExampleMenuItem_ClickS78" />
                        <MenuItem Header="识别 · 二维码与结果输出" Click="LoadDataCodeExampleMenuItem_ClickS78" />
                        <MenuItem Header="测量 · 亚像素轮廓与直线拟合" Click="LoadContourMeasurementExampleMenuItem_ClickS78" />
                    </MenuItem>
                    <MenuItem Header="帮助">
                        <MenuItem Header="中文版帮助手册" Click="OpenChineseHelpMenuItem_ClickS78" />
                        <MenuItem Header="当前模块帮助" Click="OpenCurrentModuleHelpMenuItem_ClickS78" />
                        <Separator />
                        <MenuItem Header="关于本软件" Click="AboutMenuItem_Click" />
                    </MenuItem>
                </Menu>
                <DockPanel x:Name="DeveloperAppBar" Grid.Row="1" LastChildFill="True" Height="32" Margin="8,1">
                    <StackPanel x:Name="DeveloperMetricStrip" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Border Style="{StaticResource CompactMetricUnit}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="OK" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock x:Name="MetricOkText" Text="0" Margin="4,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CompactMetricUnit}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="NG" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock x:Name="MetricNgText" Text="0" Margin="4,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CompactMetricUnit}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="良率" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock x:Name="MetricYieldText" Text="--" Margin="4,0,0,0" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CompactMetricUnit}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="节拍" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock x:Name="MetricCycleText" Text="--" Margin="4,0,0,0" FontSize="12" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="HALCON VISION" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="2,0,12,0" ToolTip="自主工业视觉平台" />
                        <TextBlock x:Name="RecipeNameText" Text="方案：未加载" Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        <Border x:Name="RecipeStateBadge" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="RecipeStateBadgeText" Text="新方案" Foreground="#92400E" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="DeveloperToolbarPanel" Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,3" VerticalAlignment="Center">
                    <Button x:Name="SaveRecipeButton" Style="{StaticResource AppBarButton}" Content="保存方案" Click="SaveRecipeButton_Click" ToolTip="保存当前方案：流程顺序、连接、参数、ROI 和界面配置" />
                    <Button x:Name="OpenImageButton" Style="{StaticResource AppBarButton}" Content="打开图像" Click="OpenImageButton_Click" ToolTip="选择一张本地图像作为当前调试输入；此操作不会开始运行" />
                    <Button x:Name="RunOnceButton" Style="{StaticResource AppBarButton}" Content="▶ 运行流程" Margin="10,1,2,1" FontWeight="Bold" Foreground="#0F766E" Click="RunOnceButton_Click" ToolTip="按流程从上到下的确定性顺序运行一次全部启用步骤" />
                    <Button x:Name="StopRunButton" Style="{StaticResource AppBarButton}" Content="■ 停止运行" Foreground="#B91C1C" Click="StopRunButton_Click" ToolTip="停止连续运行、图片批次或正在调度的流程；不能中断正在执行的单个 HALCON 算子" />
                    <Button x:Name="EnterProductionModeButton" Style="{StaticResource AppBarButton}" Content="运行界面" Margin="10,1,2,1" FontWeight="SemiBold" Foreground="#1D4ED8" Click="ToggleProductionModeButton_Click" Tag="Production" ToolTip="切换到面向操作员的运行页面；只切换页面，不会自动开始检测" />
                    <ToggleButton x:Name="DeveloperMoreToggleButton" Content="更多命令" MinHeight="26" MinWidth="66" Margin="10,1,2,1" Padding="6,1" ToolTip="打开低频命令：新建/打开方案、批量图片、连续运行、调试、变量和资源配置" />
                    <Popup x:Name="DeveloperMorePopup" IsOpen="{Binding IsChecked, ElementName=DeveloperMoreToggleButton, Mode=TwoWay}" PlacementTarget="{Binding ElementName=DeveloperMoreToggleButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,2,0,0">
                            <StackPanel Width="650">
                                <TextBlock Text="更多命令" FontWeight="SemiBold" Foreground="#334155" Margin="2,0,0,4" />
                                <WrapPanel>
                                    <Button x:Name="NewRecipeButton" Content="新建" Click="NewRecipeButton_Click" />
                                    <Button x:Name="LoadRecipeButton" Content="打开方案" Click="LoadRecipeButton_Click" />
                                    <Button x:Name="SaveRecipeAsButton" Content="另存为" Click="SaveRecipeAsButton_Click" />
                                    <Button x:Name="OpenFolderButton" Content="批量图片" Click="OpenFolderButton_Click" />
                                    <Button x:Name="PreviousImageButton" Content="上一张" Click="PreviousImageButton_Click" /><Button x:Name="NextImageButton" Content="下一张" Click="NextImageButton_Click" />
                                    <Button x:Name="RunContinuousButton" Content="连续运行" Click="RunContinuousButton_Click" /><Button Content="单步" Click="DebugStepButton_Click" /><Button Content="调试继续" Click="DebugContinueButton_Click" /><Button x:Name="PauseRunButton" Content="暂停" Click="PauseRunButton_Click" />
                                </WrapPanel>
                                <WrapPanel Margin="0,3,0,0">
                                    <TextBlock Text="间隔" Margin="7,0,1,0" VerticalAlignment="Center" Foreground="#475569" /><TextBox x:Name="ContinuousIntervalTextBox" Width="55" Text="500" />
                                    <TextBlock Text="超时" Margin="5,0,1,0" VerticalAlignment="Center" Foreground="#475569" /><TextBox x:Name="FlowTimeoutTextBox" Width="58" Text="0" /><CheckBox x:Name="StopOnNgCheckBox" Content="遇 NG 停止" Margin="5,0" VerticalAlignment="Center" />
                                    <Button x:Name="PlayButton" Content="播放" Click="PlayButton_Click" /><Button x:Name="StopPlayButton" Content="停播" Click="StopPlayButton_Click" /><Button x:Name="ClearOverlayButton" Content="清除叠加" Click="ClearOverlayButton_Click" />
                                    <Button x:Name="SaveScreenshotButton" Content="截图" Click="SaveScreenshotButton_Click" /><Button x:Name="DiagnosticsButton" Content="自检" Click="DiagnosticsButton_Click" /><Button x:Name="OpenProductionLayoutDesignerButton" Content="运行页配置" Foreground="#7C3AED" Click="OpenProductionLayoutDesignerButton_Click" />
                                    <Button Content="全局变量" Foreground="#0F766E" Click="OpenGlobalVariablesButton_Click" ToolTip="打开当前方案的强类型变量工作台" />
                                    <Button Content="外部资源" Foreground="#1D4ED8" Click="OpenExternalResourcesButton_Click" ToolTip="管理脚本使用的受管 DLL 副本、版本、哈希和引用" />
                                    <Button Content="脚本接口" Foreground="#7C3AED" Click="OpenScriptInterfaceButton_Click" ToolTip="为当前脚本实例设计类型化输入、参数和输出" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel x:Name="ProductionToolbarPanel" Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,3" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button Content="← 返回开发界面" FontWeight="SemiBold" Foreground="#1D4ED8" Click="ToggleProductionModeButton_Click" Tag="Developer" ToolTip="返回流程编辑与参数配置页面；当前运行状态会保留" />
                    <Separator Width="8" Opacity="0" />
                    <Button Content="▶ 运行流程一次" FontWeight="Bold" Foreground="#0F766E" Click="RunOnceButton_Click" ToolTip="使用当前方案运行一次完整流程" />
                    <Button Content="连续运行" Click="RunContinuousButton_Click" />
                    <Button Content="Ⅱ 暂停/继续" Click="PauseRunButton_Click" />
                    <Button Content="■ 停止" Foreground="#B91C1C" Click="StopRunButton_Click" />
                    <Separator Width="8" Opacity="0" />
                    <Button Content="上一张" Click="PreviousImageButton_Click" />
                    <Button Content="下一张" Click="NextImageButton_Click" />
                    <ComboBox x:Name="ProductionQueueRunScopeComboBox" Width="96" SelectionChanged="ProductionQueueRunScopeComboBox_SelectionChanged">
                        <ComboBoxItem Content="运行当前" Tag="Current" />
                        <ComboBoxItem Content="运行选中" Tag="Selected" />
                        <ComboBoxItem Content="运行全部" Tag="All" />
                    </ComboBox>
                    <Button Content="▶ 运行图片批次" Foreground="#0F766E" Click="RunImageQueueBatchButton_Click" ToolTip="按左侧范围运行图片队列" />
                    <Button Content="■ 停止图片批次" Foreground="#B91C1C" Click="StopImageQueueBatchButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainWorkspaceGrid" Grid.Row="1" Margin="8" SizeChanged="MainWorkspaceGrid_SizeChangedS81">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ImageWorkspaceRow" Height="4*" MinHeight="280" />
                <RowDefinition Height="5" />
                <RowDefinition x:Name="RightConfigurationRow" Height="2*" MinHeight="210" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolCatalogColumn" Width="240" MinWidth="210" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="520" MinWidth="390" />
            </Grid.ColumnDefinitions>

                    <!-- Compact industrial-vision toolbox -->
            <Border x:Name="ToolCatalogPanel" Grid.Column="0" Grid.RowSpan="3" Background="#182235" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock x:Name="ToolCatalogCapabilityText" DockPanel.Dock="Right" Text="-- 个工具 · -- 类" Foreground="#94A3B8" FontSize="10" Margin="0,7,8,0" />
                        <TextBlock Text="模块箱" Style="{StaticResource PanelHeader}" />
                    </DockPanel>
                    <TextBox x:Name="ToolSearchTextBox" Grid.Row="1" Margin="8,0,8,8" TextChanged="ToolSearchTextBox_TextChanged" ToolTip="搜索工具名称、分类或说明" />
                    <Border x:Name="ToolRecommendationContextBorder" Grid.Row="2" Visibility="Collapsed" Background="#102A43" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="7" Margin="7,0,7,6">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="ToolRecommendationBackButton" DockPanel.Dock="Right" Content="返回全目录" MinWidth="76" MinHeight="23" Padding="5,1" Click="ToolRecommendationBackButton_Click" />
                                <TextBlock Text="推荐下一工具" Foreground="#7DD3FC" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="ToolRecommendationSourceText" Text="来源 --" Foreground="#E0F2FE" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock x:Name="ToolRecommendationRuleText" Text="计划 --" Foreground="#A7F3D0" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock x:Name="ToolRecommendationRejectText" Text="拒绝原因 --" Foreground="#94A3B8" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ToolInputSourceContextBorder" Grid.Row="2" Visibility="Collapsed" Background="#172554" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="3" Padding="7" Margin="7,0,7,6">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="ToolInputSourceBackButton" DockPanel.Dock="Right" Content="返回全目录" MinWidth="76" MinHeight="23" Padding="5,1" Click="ToolInputSourceBackButton_Click" />
                                <TextBlock Text="补充上游来源" Foreground="#A5B4FC" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="ToolInputSourceTargetText" Text="目标 --" Foreground="#EEF2FF" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock x:Name="ToolInputSourceRuleText" Text="来源 --" Foreground="#A7F3D0" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock x:Name="ToolInputSourceRejectText" Text="拒绝原因 --" Foreground="#94A3B8" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <ListBox x:Name="ToolInputSourceSuggestionList" Height="98" Margin="0,5,0,0" Background="#111827" BorderBrush="#334155" Foreground="#E2E8F0" HorizontalContentAlignment="Stretch" MouseDoubleClick="ToolInputSourceSuggestionList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="5,3" BorderBrush="#334155" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="BindSelectedInputSourceButton" Content="绑定所选现有来源" MinHeight="24" Margin="0,5,0,0" Foreground="#4F46E5" FontWeight="SemiBold" Click="BindSelectedInputSourceButton_Click" />
                            <TextBlock x:Name="ToolInputSourceCreateHintText" Text="下方目录已切换为可创建来源；双击或 Enter 将工具插在目标前并连接。" Foreground="#FDE68A" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Grid x:Name="ToolCatalogModePanel" Grid.Row="3" Margin="6,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ToolCatalogAllButton" Grid.Column="0" Content="全部" MinHeight="26" Padding="3,1" Margin="0,0,2,0" Click="ToolCatalogModeButton_Click" Tag="All" ToolTip="直接显示全部分类；分类标题可就地展开或收起" />
                        <Button x:Name="ToolCatalogCommonButton" Grid.Column="1" Content="常用" MinHeight="26" Padding="3,1" Margin="0,0,2,0" Click="ToolCatalogModeButton_Click" Tag="Common" ToolTip="只显示常用工具" />
                        <Button x:Name="ToolCatalogFavoriteButton" Grid.Column="2" Content="收藏" MinHeight="26" Padding="3,1" Margin="0,0,2,0" Click="ToolCatalogModeButton_Click" Tag="Favorite" ToolTip="只显示已收藏工具" />
                        <Button x:Name="ToolCatalogRecentButton" Grid.Column="3" Content="最近" MinHeight="26" Padding="3,1" Margin="0,0,2,0" Click="ToolCatalogModeButton_Click" Tag="Recent" ToolTip="只显示最近使用工具" />
                        <Button x:Name="ToolCatalogSnippetButton" Grid.Column="4" Content="片段" MinHeight="26" Padding="3,1" Click="ToolCatalogSnippetButton_Click" ToolTip="切换本机流程片段；再次点击返回全部分类" />
                    </Grid>
                    <Grid Grid.Row="4" Margin="6,0">

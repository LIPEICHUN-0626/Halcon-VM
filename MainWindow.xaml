                                            <TextBlock x:Name="DualLeftOverlayText" Text="叠加：输入 ROI" Foreground="#67E8F9" FontSize="9" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="DualLeftPixelStatusText" Grid.Column="1" Text="像素：--" Foreground="#FDE68A" FontSize="9" Margin="8,0,0,0" />

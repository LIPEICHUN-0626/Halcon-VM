<Window x:Class="HalconWinFormsDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="HALCON 工业视觉平台"
        MinWidth="1120"
        MinHeight="700"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MaxWidth" Value="360" />
        </Style>
        <Style x:Key="MetricCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D8DEE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style x:Key="CompactMetricUnit" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="#D8DEE9" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AppBarButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="50" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="6,1" />
        </Style>
        <Style x:Key="PanelHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,8" />
        </Style>
        <DrawingBrush x:Key="FlowGridBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F7F9FC" Geometry="M0,0 H24 V24 H0 Z" />
                    <GeometryDrawing Brush="#DDE4EE" Geometry="M23,23 H25 V25 H23 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#E9EEF5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="440" />
            <RowDefinition Height="22" />
            <RowDefinition x:Name="BottomPanelRow" Height="0" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Menu x:Name="MainMenu" Grid.Row="0" Background="#F8FAFC" BorderBrush="#D7DEE8" BorderThickness="0,0,0,1" Padding="4,1">
                    <MenuItem Header="文件">
                        <MenuItem Header="新建方案" Click="NewRecipeButton_Click" />
                        <MenuItem Header="打开方案" Click="LoadRecipeButton_Click" />
                        <MenuItem x:Name="RecentRecipesMenuUI09" Header="最近方案" SubmenuOpened="RecentRecipesMenuUI09_SubmenuOpened" ToolTip="主动打开最近保存或打开过的方案；不会在启动时自动恢复。">
                            <MenuItem Header="暂无最近方案" IsEnabled="False" />
                        </MenuItem>
                        <MenuItem Header="保存方案" Click="SaveRecipeButton_Click" />
                        <MenuItem Header="方案另存为" Click="SaveRecipeAsButton_Click" />
                        <MenuItem Header="换型与运行准备…" Click="OpenRecipePreparationS134_Click" ToolTip="只读预览目标方案与资源问题，显式确认换型；不会自动采集、运行或启用触发。" />
                        <MenuItem Header="运行周期记录…" Click="OpenProductionRunHistoryS135_Click" ToolTip="查询已保存的整流程周期。生产、开发与调试来源明确区分，历史只读，不运行或外发。" />
                        <MenuItem Header="报警查看与处置…" Click="OpenProductionAlarmsS136_Click" ToolTip="查看发生事实、确认阅读和记录人工处置；不会恢复设备、解除保护或重发结果。" />
                        <MenuItem Header="导出工程副本…" Click="ExportRecipeImagesS95_Click" ToolTip="按同一冻结清单复制图像、模型、字库、标定文件、正式脚本和资源库DLL本体，附目标机器准备报告；间接依赖、运行库、许可和设备环境不自动配置。" />
                        <Separator />
                        <MenuItem Header="打开图片" Click="OpenImageButton_Click" />
                        <MenuItem Header="批量图片" Click="OpenFolderButton_Click" />
                    </MenuItem>
                    <MenuItem Header="编辑">
                        <MenuItem x:Name="UndoFlowEditMenuItem" Header="撤销流程编辑" InputGestureText="Ctrl+Z" Click="UndoFlowEditButton_Click" />
                        <MenuItem x:Name="RedoFlowEditMenuItem" Header="重做流程编辑" InputGestureText="Ctrl+Y" Click="RedoFlowEditButton_Click" />
                        <Separator />
                        <MenuItem Header="复制模块" InputGestureText="Ctrl+C" Click="CopyFlowToolButton_Click" />
                        <MenuItem Header="粘贴模块" InputGestureText="Ctrl+V" Click="PasteFlowToolButton_Click" />
                        <MenuItem Header="创建副本" Click="DuplicateFlowToolButton_Click" />
                        <MenuItem Header="批量编辑所选模块">
                            <MenuItem Header="批量命名…" Click="BatchRenameToolsS99_Click" ToolTip="按流程顺序预览并生成唯一名称；一次撤销整体回退。" />
                            <MenuItem Header="复用数值判定规则…" Click="BatchCopyJudgeRulesS99_Click" ToolTip="多选数值判定，选择规则来源；只复制比较方式、上下限、容差，不改变输入订阅。" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="创建流程组合" Click="CreateFlowGroupButton_Click" />
                        <MenuItem Header="所选模块创建子流程…" Click="CreateSubflowS102_Click" ToolTip="将连续模块封装成有真实输入和返回值的调用节点；预览边界后创建，一次撤销可恢复。" />
                        <MenuItem Header="解组" Click="UngroupFlowGroupButton_Click" />
                        <MenuItem Header="折叠组合" Click="CollapseFlowGroupButton_Click" />
                        <MenuItem Header="展开组合" Click="ExpandFlowGroupButton_Click" />
                        <MenuItem Header="应用组合名称" Click="RenameFlowGroupButton_Click" />
                    </MenuItem>
                    <MenuItem Header="运行">
                        <MenuItem Header="运行当前流程" Click="RunOnceButton_Click" ToolTip="按当前流程顺序运行全部启用模块；不会运行方案里的其他流程。" />
                        <MenuItem Header="运行选中模块" Click="RunCurrentToolButton_Click" ToolTip="使用所选模块的已应用参数；参数小窗的F5才使用正在编辑的草稿。" />
                        <MenuItem Header="运行到此" Click="RunToHereButton_Click" />
                        <MenuItem Header="从此运行" Click="RunFromHereButton_Click" />
                        <Separator />
                        <MenuItem Header="单步执行" InputGestureText="F10" Click="DebugStepButton_Click" />
                        <MenuItem Header="继续调试" InputGestureText="F5" Click="DebugContinueButton_Click" />
                        <MenuItem Header="设置 / 取消所选断点" InputGestureText="F9" Click="ToggleBreakpointButton_Click" />
                        <MenuItem Header="清除全部断点" Click="ClearBreakpointsButton_Click" />
                        <Separator />
                        <MenuItem Header="连续运行" Click="RunContinuousButton_Click" />
                        <MenuItem Header="暂停 / 继续" Click="PauseRunButton_Click" />
                        <MenuItem Header="停止任务" InputGestureText="Shift+F5" Click="StopRunButton_Click" />
                    </MenuItem>
                    <MenuItem Header="视图">
                        <MenuItem Header="切换到运行界面" Click="ToggleProductionModeButton_Click" Tag="Production" ToolTip="只切换到操作员运行页面，不会自动开始检测" />
                        <MenuItem Header="工程编辑保护…" Click="OpenStationProtectionS137_Click" ToolTip="显式设置本机编辑保护或工程解锁；切换页面不是授权。保护不随方案导入覆盖。" />
                        <MenuItem Header="锁定工程编辑" Click="LockStationEngineeringS137_Click" ToolTip="仅启用保护后生效；先明确处理草稿。不会强停当前算子或自动运行设备。" />
                        <Separator />
                        <MenuItem Header="流程适应窗口" Click="FitFlowButton_Click" />
                        <MenuItem Header="图像适应窗口" Click="FitImageButton_Click" />
                        <Separator />
                        <MenuItem Header="全局变量" Click="OpenGlobalVariablesButton_Click" />
                        <MenuItem Header="外部资源" Click="OpenExternalResourcesButton_Click" />
                        <MenuItem Header="脚本接口" Click="OpenScriptInterfaceButton_Click" />
                        <MenuItem Header="项目自检" Click="DiagnosticsButton_Click" />
                    </MenuItem>
                    <MenuItem x:Name="ExampleProgramsMenuS78" Header="示例程序" ToolTip="装载可编辑、可运行的真实学习方案；不会自动执行">
                        <MenuItem Header="完整学习项目" ToolTip="真实组合流程与按需步骤引导；模板、参考及标定仍须自己明确建立，不自动运行。">
                            <MenuItem Header="对象检测、条件判定与生产查看" Click="LoadObjectProductionLearningProjectS146_Click" ToolTip="阈值 → 对象与面积数组 → 数量判定 → 条件执行与生产结果项；学习门槛不是产品标准，证据默认关闭，不连接设备。" />
                            <MenuItem Header="明确选取、参考对齐与边缘测量" Click="LoadAlignmentLineLearningProjectS146_Click" ToolTip="NCC SelectedPose → 固定参考对齐 → 搜索带找边与覆盖判定；须自己训练、应用、重新运行并采参考，不预造模型或位姿。" />
                            <MenuItem Header="同链标定与世界距离" Click="LoadWorldDistanceLearningProjectS146_Click" ToolTip="真实边缘点 → 像素端点 → 平面标定 → 世界距离判定；须自己采像素/世界对应点与真实单位，不预造毫米结果或精度证明。" />
                        </MenuItem>
                        <MenuItem Header="当前项目学习步骤…" Click="OpenLearningProjectGuideS146_Click" ToolTip="按需查看当前学习项目的一步说明，明确打开已有模块；临时步号不是运行准备、结果合格或验收，不自动训练、应用、运行或保存。" />
                        <Separator />
                        <MenuItem Header="入门">
                            <MenuItem Header="入门 · 亮度分布与沿线分析（自带图像）" Click="LoadIlluminationExampleS94_Click" ToolTip="学习图像分支订阅、灰度分布、图像取线与数值判定；无需查找外部示例图片。" />
                            <MenuItem Header="入门 · 基础分割与区域测量" Click="LoadBasicSegmentationExampleMenuItem_ClickS78" />
                            <MenuItem Header="采集 · 离线逐帧回放" Click="LoadImageReplayExampleS114_Click" ToolTip="图像源逐帧读取 HALCON 示例图片目录，经灰度转换进入亮度分布；每次运行读取下一帧。" />
                        </MenuItem>
                        <MenuItem Header="检测定位">
                            <MenuItem Header="检测 · 颜色取样与覆盖比例" Click="LoadColorExampleS129_Click" ToolTip="RGB 图像直接取色，经 HSV 掩膜、区域筛选与覆盖比例判定；示例不自动运行，阈值仅用于学习。" />
                            <MenuItem Header="检测 · 良品学习与表面缺陷" Click="LoadVariationExampleS130_Click" ToolTip="学习从至少 3 张已对齐良品训练 HALCON 变化模型，再把缺陷面积接数值判定；示例不自动训练或运行。" />
                            <MenuItem Header="定位 · NCC 灰度模板" Click="LoadNccExampleS131_Click" ToolTip="图像源直接连接 NCC，在模块内框选并制作模板，将分数接数值判定；不自动训练或运行。" />
                            <MenuItem Header="定位 · 模板多目标与明确选取" Click="LoadTemplateTargetsExampleS145_Click" ToolTip="从真实匹配产生同序中心、分数、角度与尺度数组，再按明确编号选取；查看不改最佳输出，不自动训练或运行。" />
                            <MenuItem Header="区域 · 连通对象分析与选取" Click="LoadObjectExampleS144_Click" ToolTip="阈值区域 → 同序中心/面积与明确选取 → 面积数组统计/数量判定；不自动运行，不预造合格输出。" />
                            <MenuItem Header="图像 · 定位后对齐" Click="LoadAlignmentExampleS132_Click" ToolTip="NCC 位姿驱动真实图像刚体对齐；先制作模板，再保存固定参考。不会自动训练或运行。" />
                            <MenuItem Header="识别 · OCR 逐字结果与校验" Click="LoadOcrValidationExampleS133_Click" ToolTip="学习真实字符置信度、选中定位和文本规则；示例不自动执行或外发。" />
                            <MenuItem Header="识别 · 二维码与结果输出" Click="LoadDataCodeExampleMenuItem_ClickS78" />
                            <MenuItem Header="图像 · 双来源独立检测" Click="LoadMultiImageExampleS112_Click" ToolTip="两路本地图像源分别驱动颗粒分割与灰度分布；运行后在图像区按来源切换，学习 ROI 与结果按图像链隔离。" />
                            <MenuItem Header="图像 · 双源配对与绝对差分" Click="LoadPairedDifferenceExampleS113_Click" ToolTip="两路图像源、参考图平滑、双图绝对差分与区域轮廓；学习两个目录按同名文件成组运行。初始两源使用同一 HALCON 示例图，可换成自己的配对目录。" />
                        </MenuItem>
                        <MenuItem Header="测量标定">
                            <MenuItem Header="测量 · 图像边缘找直线" Click="LoadEdgeLineExampleS143_Click" ToolTip="图像源 → 图上搜索带/单边采样 → 有效覆盖判定；请将搜索带放在真实直边，不自动运行，不预设成功结果。" />
                            <MenuItem Header="测量 · 亚像素轮廓与直线拟合" Click="LoadContourMeasurementExampleMenuItem_ClickS78" />
                        </MenuItem>
                        <MenuItem Header="数据扩展">
                            <MenuItem Header="数据 · 数组整理与标签关联（无需图像）" Click="LoadArrayReorderExampleS108_Click" ToolTip="学习稳定排序、保序切片、两批合并，以及标签跟随来源索引重排；不自动执行或外发。" />
                            <MenuItem Header="数据 · 方案数组缓存与读写（无需图像）" Click="LoadVariableArraysExampleS109_Click" ToolTip="学习数值/文本数组变量的写入、读取与下游复用；保存包含默认值和当前值，打开不会自动清空缓存。" />
                            <MenuItem Header="数据 · 结构化报文与测量结果（无需图像）" Click="LoadJsonExampleS110_Click" ToolTip="读取产品信息与尺寸数组，统计后组装 JSON，再读取结果；不自动执行或外发。" />
                            <MenuItem Header="脚本 · 数组逐项补偿（无需图像）" Click="LoadScriptArrayExampleS107_Click" ToolTip="数值/文本数组进入受信任 C#，补偿后返回真实数组并统计、取值和判定；不自动执行或外发。" />
                            <MenuItem Header="计算 · 测量偏差与数值公式（无需图像）" Click="LoadExpressionExampleS106_Click" ToolTip="学习数组统计后用公式计算偏差百分比与尺寸极差，再连接判定；不自动运行或发送结果。" />
                            <MenuItem Header="数据 · 数组统计与报文组装（无需图像）" Click="LoadArrayExampleS105_Click" ToolTip="数值数组传入子流程统计，均值判定与文本字段组装为报文；不自动运行、不连接设备、不发送结果。" />
                        </MenuItem>
                        <MenuItem Header="流程工程">
                            <MenuItem Header="流程 · 子流程逐项补偿与固定编号（无需图像）" Click="LoadSubflowLoopExampleS111_Click" ToolTip="学习数组逐项和固定次数执行，补偿结果与编号收集为数组；不自动运行或外发。" />
                            <MenuItem Header="方案 · 双流程检测与指令触发（自带图像）" Click="LoadMultiFlowExampleS104_Click" ToolTip="一个方案包含亮度检测和圆弧测量；学习流程切换、结果归属、恢复与保存。只预填触发配置，不连接设备、不自动运行或启用触发。" />
                            <MenuItem Header="数据 · 几何点集跨子流程复用（自带图像）" Click="LoadGeometryReuseExampleS103_Click" ToolTip="圆弧卡尺点集从第一个子流程返回，传入第二个子流程拟合圆，再用 Point2D/Circle2D 测量；沿用同一坐标，不自动运行。" />
                            <MenuItem Header="数据 · 判定选择几何分支（自带图像）" Click="LoadGeometryBranchExampleS103_Click" ToolTip="通过时沿用原拟合圆，未通过时执行几何拟合子流程；Circle2D 分支结果继续驱动点圆测量。不自动运行，也不把回退执行等同质量通过。" />
                            <MenuItem Header="流程 · 子流程检测与返回（自带图像）" Click="LoadSubflowExampleS102_Click" ToolTip="自带图像 → 子流程内阈值与轮廓 → 返回区域/面积 → 亮度与判定；学习进入内部、接口、F5/连续、调用记录和返回上级，不自动运行。" />
                            <MenuItem Header="流程 · 判定驱动真 / 假分支（自带图像）" Click="LoadConditionalExampleS100_Click" ToolTip="学习用同一 Passed 布尔输出驱动真/假两个分支；本示例关闭遇 NG 停止，不自动执行。" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="帮助">
                        <MenuItem Header="中文版帮助手册" Click="OpenChineseHelpMenuItem_ClickS78" />
                        <MenuItem Header="当前模块帮助" Click="OpenCurrentModuleHelpMenuItem_ClickS78" />
                        <Separator />
                        <MenuItem Header="关于本软件" Click="AboutMenuItem_Click" />
                    </MenuItem>
                </Menu>
                <DockPanel x:Name="DeveloperAppBar" Grid.Row="1" LastChildFill="True" Height="32" Margin="8,1">
                    <StackPanel x:Name="DeveloperMetricStrip" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch" Visibility="Collapsed">
                        <Border Style="{StaticResource CompactMetricUnit}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="OK" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock x:Name="MetricOkText" Text="0" Margin="4,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CompactMetricUnit}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="NG" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock x:Name="MetricNgText" Text="0" Margin="4,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CompactMetricUnit}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="良率" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock x:Name="MetricYieldText" Text="--" Margin="4,0,0,0" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CompactMetricUnit}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="节拍" Foreground="#64748B" VerticalAlignment="Center" /><TextBlock x:Name="MetricCycleText" Text="--" Margin="4,0,0,0" FontSize="12" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="HALCON VISION" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" Margin="2,0,12,0" ToolTip="自主工业视觉平台" />
                        <TextBlock x:Name="RecipeNameText" Text="方案：未加载" Foreground="#475569" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        <Border x:Name="RecipeStateBadge" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="RecipeStateBadgeText" Text="新方案" Foreground="#92400E" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="DeveloperToolbarPanel" Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,3" VerticalAlignment="Center">
                    <Button x:Name="SaveRecipeButton" Style="{StaticResource AppBarButton}" Content="保存方案" Click="SaveRecipeButton_Click" ToolTip="保存当前方案：流程顺序、连接、参数、ROI 和界面配置" />
                    <Button x:Name="OpenImageButton" Style="{StaticResource AppBarButton}" Content="打开图像" Click="OpenImageButton_Click" ToolTip="选择一张本地图像作为当前调试输入；此操作不会开始运行" />
                    <Button x:Name="RunOnceButton" Style="{StaticResource AppBarButton}" Content="▶ 运行流程" Margin="10,1,2,1" FontWeight="Bold" Foreground="#0F766E" Click="RunOnceButton_Click" ToolTip="按流程从上到下的确定性顺序运行一次全部启用步骤" />

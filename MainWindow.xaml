                                <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                                <TextBlock Text="资源名称" VerticalAlignment="Center" /><TextBox x:Name="ExternalResourceNameTextBox" Grid.Column="1" />
                                <TextBlock Grid.Column="2" Text="健康状态" Margin="12,0,0,0" VerticalAlignment="Center" /><TextBlock x:Name="ExternalResourceHealthText" Grid.Column="3" Text="待导入" Foreground="#0F766E" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="类型全名" VerticalAlignment="Center" /><TextBox x:Name="ExternalResourceTypeNameTextBox" Grid.Column="1" Text="UserScripts.ScriptEntry" /></Grid>
                            <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="静态方法" VerticalAlignment="Center" /><TextBox x:Name="ExternalResourceMethodNameTextBox" Grid.Column="1" Text="Execute" /></Grid>
                            <Grid Grid.Row="4" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="原始来源" VerticalAlignment="Top" /><TextBlock x:Name="ExternalResourceSourcePathText" Grid.Column="1" Text="导入时选择 DLL" Foreground="#475569" TextWrapping="Wrap" /></Grid>
                            <Grid Grid.Row="5" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="受管副本" VerticalAlignment="Top" /><TextBlock x:Name="ExternalResourceManagedPathText" Grid.Column="1" Text="--" Foreground="#475569" TextWrapping="Wrap" /></Grid>
                            <Border Grid.Row="6" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="版本 / SHA" FontWeight="SemiBold" Foreground="#334155" /><TextBlock x:Name="ExternalResourceVersionHashText" Grid.Column="1" Text="--" Foreground="#1D4ED8" FontFamily="Consolas" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="流程引用" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="#334155" /><TextBlock x:Name="ExternalResourceReferenceText" Grid.Row="1" Grid.Column="1" Text="引用 0" Margin="0,5,0,0" Foreground="#475569" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="诊断" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="#334155" /><TextBlock x:Name="ExternalResourceDiagnosticsText" Grid.Row="2" Grid.Column="1" Text="导入后显示签名与完整性状态。" Margin="0,5,0,0" Foreground="#64748B" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="7" x:Name="ExternalResourceValidationText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="2,12,2,0" />
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,8">
                    <DockPanel>
                        <TextBlock x:Name="ExternalResourceWorkspaceStatusText" Text="0 个资源" VerticalAlignment="Center" Foreground="#64748B" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="刷新来源" Click="RefreshExternalResourceButton_Click" />
                            <Button Content="替换来源…" Click="ReplaceExternalResourceButton_Click" />
                            <Button Content="删除" Foreground="#B91C1C" Click="DeleteExternalResourceButton_Click" />
                            <Button Content="应用入口" Foreground="#1D4ED8" FontWeight="SemiBold" Click="ApplyExternalResourceButton_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="ScriptInterfaceWorkspace" Grid.Row="1" Margin="8" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="5" Panel.ZIndex="92">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="0,0,0,1" Padding="14,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="关闭" MinWidth="64" Click="CloseScriptInterfaceButton_Click" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="脚本接口设计器" FontSize="18" FontWeight="SemiBold" Foreground="#3B1B66" />
                                <Border Background="#EDE9FE" CornerRadius="8" Padding="7,2" Margin="10,1,0,0"><TextBlock x:Name="ScriptInterfaceToolNameText" Text="未选择脚本" Foreground="#6D28D9" FontWeight="SemiBold" /></Border>
                            </StackPanel>
                            <TextBlock Text="当前脚本实例 · 类型化标量接口 · 稳定成员 ID；仅在需要时占用工作区" Foreground="#6D5A90" FontSize="11" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="接口成员" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" />
                                <TextBlock x:Name="ScriptInterfaceCountText" DockPanel.Dock="Right" Text="输入 0 · 参数 0 · 输出 0" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Margin="0,9,0,7">
                                <Button Content="＋ 输入" Foreground="#0369A1" Click="AddScriptInputButton_Click" />
                                <Button Content="＋ 参数" Foreground="#B45309" Click="AddScriptParameterButton_Click" />
                                <Button Content="＋ 输出" Foreground="#15803D" Click="AddScriptOutputButton_Click" />
                            </WrapPanel>
                            <ListBox x:Name="ScriptInterfaceMemberListBox" Grid.Row="2" BorderThickness="0" SelectionChanged="ScriptInterfaceMemberListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="7,6">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1E293B" /><TextBlock Text="{Binding SummaryText}" Foreground="#64748B" FontSize="11" /></StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding MemberId}" Foreground="#B8B3C7" FontFamily="Consolas" FontSize="9" MaxWidth="72" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="创建副本" Click="DuplicateScriptMemberButton_Click" />
                                <Button Content="删除" Foreground="#B91C1C" Click="DeleteScriptMemberButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="16">
                        <Grid>
                            <TextBlock x:Name="ScriptInterfaceEmptyText" Text="从左侧选择成员，或添加一个输入、参数、输出。" Foreground="#64748B" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Grid x:Name="ScriptInterfaceEditorPanel">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="成员设置" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                                    <TextBlock x:Name="ScriptInterfaceMemberIdText" DockPanel.Dock="Right" Foreground="#94A3B8" FontFamily="Consolas" FontSize="10" />
                                </DockPanel>
                                <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="方向" VerticalAlignment="Center" /><ComboBox x:Name="ScriptInterfaceDirectionComboBox" Grid.Column="1" DisplayMemberPath="DisplayText" SelectedValuePath="Key" />
                                    <TextBlock Grid.Column="2" Text="类型" Margin="12,0,0,0" VerticalAlignment="Center" /><ComboBox x:Name="ScriptInterfaceTypeComboBox" Grid.Column="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" />
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="名称" VerticalAlignment="Center" /><TextBox x:Name="ScriptInterfaceNameTextBox" Grid.Column="1" /></Grid>
                                <Grid x:Name="ScriptInterfaceDefaultRow" Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="默认值" VerticalAlignment="Center" /><TextBox x:Name="ScriptInterfaceDefaultTextBox" Grid.Column="1" /></Grid>
                                <Grid Grid.Row="4" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="约束" VerticalAlignment="Center" /><CheckBox x:Name="ScriptInterfaceRequiredCheckBox" Grid.Column="1" Content="必需；缺失时立即停止当前工具并清除旧输出" VerticalAlignment="Center" /></Grid>
                                <Grid Grid.Row="5" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="说明" VerticalAlignment="Top" /><TextBox x:Name="ScriptInterfaceDescriptionTextBox" Grid.Column="1" Height="54" AcceptsReturn="True" TextWrapping="Wrap" /></Grid>
                                <Border Grid.Row="6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <DockPanel><TextBlock Text="代码访问" FontWeight="SemiBold" Foreground="#334155" /><Button DockPanel.Dock="Right" Content="复制代码" Padding="7,2" Click="CopyScriptSnippetButton_Click" /></DockPanel>
                                        <TextBox x:Name="ScriptInterfaceSnippetTextBox" Grid.Row="1" Margin="0,7,0,0" IsReadOnly="True" FontFamily="Consolas" Background="#FFFFFF" BorderBrush="#CBD5E1" />
                                        <TextBlock x:Name="ScriptInterfacePortText" Grid.Row="2" Margin="0,6,0,0" Foreground="#64748B" FontFamily="Consolas" FontSize="10" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="7" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,12,0,0"><Button Content="应用成员草稿" Foreground="#7C3AED" FontWeight="SemiBold" Click="ApplyScriptMemberButton_Click" /></StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,8">
                    <DockPanel LastChildFill="False">
                        <StackPanel>
                            <TextBlock x:Name="ScriptInterfaceContractText" Text="固定入口：public static ScriptToolResult Execute(ScriptToolContext input)" Foreground="#475569" FontFamily="Consolas" FontSize="10" />
                            <TextBlock x:Name="ScriptInterfaceValidationText" Text="接口草稿尚未修改。" Foreground="#64748B" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="取消草稿" Click="CancelScriptInterfaceButton_Click" />
                            <Button Content="应用接口" Foreground="#7C3AED" FontWeight="SemiBold" Click="ApplyScriptInterfaceButton_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Background="#E9EEF5">
            <GridSplitter x:Name="BottomPanelSplitter" Height="5" Background="#CBD5E1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Visibility="Collapsed" />
            <ToggleButton x:Name="BottomPanelToggleButton" Content="结果 / 日志 ▾" Height="20" MinWidth="104" Padding="8,0" Margin="0,1,9,1" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BottomPanelToggleButton_Click" ToolTip="展开或收起结果、日志、追溯和报警；状态保存在本机布局" />
        </Grid>

        <TabControl Grid.Row="3" x:Name="BottomTabs" Margin="8,0,8,5" Visibility="Collapsed">
            <TabItem Header="结果记录">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="4">
                        <Button x:Name="ReviewResultButton" Content="回看结果" Click="ReviewResultButton_Click" /><Button x:Name="ExportCsvButton" Content="导出CSV" Click="ExportCsvButton_Click" /><Button x:Name="ExportXlsxButton" Content="导出XLSX" Click="ExportXlsxButton_Click" /><Button x:Name="ClearResultsButton" Content="清空记录" Click="ClearResultsButton_Click" />
                    </WrapPanel>
                    <DataGrid x:Name="ResultsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="48" /><DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="100" /><DataGridTextColumn Header="类型" Binding="{Binding InspectionType}" Width="145" /><DataGridTextColumn Header="判定" Binding="{Binding ResultCode}" Width="65" /><DataGridTextColumn Header="分数/数量" Binding="{Binding Score, StringFormat=F3}" Width="82" /><DataGridTextColumn Header="ROI" Binding="{Binding RoiType}" Width="75" /><DataGridTextColumn Header="图像" Binding="{Binding ImageSource}" Width="180" /><DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="运行日志">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="4"><Button x:Name="ClearLogButton" Content="清空日志" Click="ClearLogButton_Click" /><Button x:Name="OpenLogDirectoryButton2" Content="打开日志目录" Click="OpenLogDirectoryButton_Click" /></WrapPanel>
                    <TextBox x:Name="BottomLogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem x:Name="BatchTraceTab" Header="批次追溯">
                <Grid Margin="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,4">
                        <TextBlock Text="从" VerticalAlignment="Center" /><DatePicker x:Name="BatchTraceFromDatePicker" Width="125" SelectedDateChanged="BatchTraceFilter_Changed" />
                        <TextBlock Text="到" VerticalAlignment="Center" Margin="6,0,0,0" /><DatePicker x:Name="BatchTraceToDatePicker" Width="125" SelectedDateChanged="BatchTraceFilter_Changed" />
                        <TextBlock Text="批次" VerticalAlignment="Center" Margin="6,0,0,0" /><TextBox x:Name="BatchTraceIdFilterTextBox" Width="110" TextChanged="BatchTraceFilter_Changed" />
                        <TextBlock Text="方案" VerticalAlignment="Center" Margin="6,0,0,0" /><TextBox x:Name="BatchTraceRecipeFilterTextBox" Width="105" TextChanged="BatchTraceFilter_Changed" />
                        <TextBlock Text="结果" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <ComboBox x:Name="BatchTraceResultFilterComboBox" Width="88" SelectedIndex="0" SelectionChanged="BatchTraceFilter_Changed">
                            <ComboBoxItem Content="全部" Tag="All" /><ComboBoxItem Content="OK" Tag="OK" /><ComboBoxItem Content="NG" Tag="NG" /><ComboBoxItem Content="异常" Tag="Error" /><ComboBoxItem Content="停止" Tag="Stopped" />
                        </ComboBox>
                        <Button Content="重新加载" Click="ReloadBatchTraceButton_Click" /><Button Content="导出筛选 CSV" Foreground="#0F766E" Click="ExportBatchTraceCsvButton_Click" />
                        <TextBlock x:Name="BatchTraceSummaryText" Text="尚无批次记录" Foreground="#475569" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </WrapPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <DataGrid x:Name="BatchTraceGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="BatchTraceGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAtText}" Width="135" /><DataGridTextColumn Header="批次 ID" Binding="{Binding BatchId}" Width="135" />
                                <DataGridTextColumn Header="方案" Binding="{Binding RecipeDisplay}" Width="115" /><DataGridTextColumn Header="指纹" Binding="{Binding FingerprintShort}" Width="90" />
                                <DataGridTextColumn Header="范围" Binding="{Binding ScopeText}" Width="75" /><DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="62" />
                                <DataGridTextColumn Header="统计" Binding="{Binding CountsText}" Width="220" /><DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" Width="5" Background="#CBD5E1" HorizontalAlignment="Stretch" />
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <WrapPanel>
                                <Button Content="回看所选" Foreground="#B45309" FontWeight="SemiBold" Click="ReviewSelectedBatchTraceItemButton_Click" />
                                <Button Content="删除所选批次" Foreground="#B91C1C" Click="DeleteSelectedBatchTraceButton_Click" />
                                <CheckBox x:Name="BatchTraceSaveImagesCheckBox" Content="保存图像" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0" Checked="BatchTraceStorageSettings_Changed" Unchecked="BatchTraceStorageSettings_Changed" />
                                <CheckBox x:Name="BatchTraceSaveLayersCheckBox" Content="保存图层" IsChecked="True" VerticalAlignment="Center" Checked="BatchTraceStorageSettings_Changed" Unchecked="BatchTraceStorageSettings_Changed" />
                                <TextBlock Text="保留批" VerticalAlignment="Center" Margin="8,0,2,0" /><TextBox x:Name="BatchTraceMaximumBatchCountTextBox" Width="48" Text="50" LostKeyboardFocus="BatchTraceStorageSettings_Changed" />
                                <TextBlock Text="容量MB" VerticalAlignment="Center" Margin="6,0,2,0" /><TextBox x:Name="BatchTraceMaximumMegabytesTextBox" Width="62" Text="2048" LostKeyboardFocus="BatchTraceStorageSettings_Changed" />
                                <Button Content="清理孤立资源" Click="CleanupOrphanBatchAssetsButton_Click" />
                            </WrapPanel>
                        <DataGrid x:Name="BatchTraceItemGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="BatchTraceItemGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding SequenceText}" Width="36" /><DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="130" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="58" /><DataGridTextColumn Header="结果码" Binding="{Binding ResultCode}" Width="65" />
                                <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="72" /><DataGridTextColumn Header="快照" Binding="{Binding AssetStateText}" Width="102" /><DataGridTextColumn Header="图层" Binding="{Binding LayerCountText}" Width="48" /><DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                            <TextBlock x:Name="BatchTraceStorageSummaryText" Grid.Row="2" Text="本地结果快照：未加载" Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="3" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="报警"><TextBox x:Name="AlarmTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
            <TabItem Header="通讯记录"><TextBox x:Name="TcpHistoryTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
        </TabControl>

        <StatusBar Grid.Row="4" Background="#FFFFFF" BorderBrush="#D6DCE5" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="ModeStatusText" Text="模式：手动调试" /></StatusBarItem><Separator />
            <StatusBarItem><TextBlock x:Name="FlowRuntimeStatusBarText" Text="流程：待命" /></StatusBarItem><Separator />
            <StatusBarItem><TextBlock x:Name="ImageStatusText" Text="图像：--" /></StatusBarItem><Separator />
            <StatusBarItem><TextBlock x:Name="ZoomStatusText" Text="缩放：--" /></StatusBarItem><Separator />
            <StatusBarItem><TextBlock x:Name="MouseStatusText" Text="坐标：--" /></StatusBarItem><Separator />
            <StatusBarItem><TextBlock x:Name="RoiStatusBarText" Text="ROI：未设置" /></StatusBarItem><Separator />
            <StatusBarItem><TextBlock x:Name="TemplateStatusBarText" Text="模板：未训练" /></StatusBarItem><Separator />
            <StatusBarItem><TextBlock x:Name="TcpStatusBarText" Text="TCP：未连接" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

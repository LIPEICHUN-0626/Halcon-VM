                                        <TextBlock Grid.Column="2" Text="灰度上限" VerticalAlignment="Center" /><TextBox x:Name="BlobMaxGrayTextBox" Grid.Column="3" Text="255" LostFocus="ToolParameter_LostFocus" />
                                        <TextBlock Grid.Row="1" Text="最小面积" VerticalAlignment="Center" /><TextBox x:Name="BlobMinAreaTextBox" Grid.Row="1" Grid.Column="1" Text="50" LostFocus="ToolParameter_LostFocus" />
                                    </Grid>
                                </GroupBox>
                            </StackPanel>

                            <StackPanel x:Name="GrayInspectorPanel" Visibility="Collapsed">
                                <GroupBox Header="灰度统计参数">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="灰度下限" VerticalAlignment="Center" /><TextBox x:Name="GrayMinTextBox" Grid.Column="1" Text="0" LostFocus="ToolParameter_LostFocus" />
                                        <TextBlock Grid.Column="2" Text="灰度上限" VerticalAlignment="Center" /><TextBox x:Name="GrayMaxTextBox" Grid.Column="3" Text="255" LostFocus="ToolParameter_LostFocus" />
                                    </Grid>
                                </GroupBox>
                            </StackPanel>

                            <StackPanel x:Name="EdgeInspectorPanel" Visibility="Collapsed">
                                <GroupBox Header="边缘测量参数">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="边缘阈值" VerticalAlignment="Center" /><TextBox x:Name="EdgeThresholdTextBox" Grid.Column="1" Text="30" LostFocus="ToolParameter_LostFocus" />
                                    </Grid>
                                </GroupBox>
                            </StackPanel>

                            <StackPanel x:Name="HDevInspectorPanel" Visibility="Collapsed">
                                <GroupBox Header="HDevelop 扩展">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="过程名" VerticalAlignment="Center" /><TextBox x:Name="HDevProcedureTextBox" Grid.Column="1" Grid.ColumnSpan="2" Text="RunInspection" />
                                        <TextBlock Grid.Row="1" Text="程序" VerticalAlignment="Center" /><TextBox x:Name="HDevPathTextBox" Grid.Row="1" Grid.Column="1" /><Button x:Name="BrowseHDevButton" Grid.Row="1" Grid.Column="2" Content="选择文件" Click="BrowseHDevButton_Click" />
                                    </Grid>
                                </GroupBox>
                            </StackPanel>

                            <StackPanel x:Name="NumericJudgeInspectorPanel" Visibility="Collapsed">
                                <GroupBox Header="上游数值订阅">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="上游工具" VerticalAlignment="Center" />
                                        <ComboBox x:Name="NumericSourceToolComboBox" Grid.Column="1" DisplayMemberPath="DisplayText" SelectedValuePath="ToolId" SelectionChanged="NumericSourceToolComboBox_SelectionChanged" />
                                        <TextBlock Grid.Row="1" Text="数值端口" VerticalAlignment="Center" />
                                        <ComboBox x:Name="NumericSourcePortComboBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="DisplayText" SelectedValuePath="PortName" SelectionChanged="NumericSourcePortComboBox_SelectionChanged" />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="判定规则">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="比较方式" VerticalAlignment="Center" />
                                        <ComboBox x:Name="NumericOperatorComboBox" Grid.Column="1" Grid.ColumnSpan="3" DisplayMemberPath="DisplayText" SelectedValuePath="Key" SelectionChanged="NumericOperatorComboBox_SelectionChanged" />
                                        <TextBlock Grid.Row="1" Text="下限/目标" VerticalAlignment="Center" />
                                        <TextBox x:Name="NumericLowerLimitTextBox" Grid.Row="1" Grid.Column="1" Text="0" LostFocus="NumericJudgeParameter_LostFocus" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="上限" VerticalAlignment="Center" />
                                        <TextBox x:Name="NumericUpperLimitTextBox" Grid.Row="1" Grid.Column="3" Text="100" LostFocus="NumericJudgeParameter_LostFocus" />
                                        <TextBlock Grid.Row="2" Text="相等容差" VerticalAlignment="Center" />
                                        <TextBox x:Name="NumericToleranceTextBox" Grid.Row="2" Grid.Column="1" Text="0.001" LostFocus="NumericJudgeParameter_LostFocus" />
                                    </Grid>
                                </GroupBox>
                                <TextBlock x:Name="NumericConfigValidationText" Text="请选择上游工具和端口。" TextWrapping="Wrap" Margin="4,0,4,6" Foreground="#B91C1C" />
                                <UniformGrid Columns="2">
                                    <Button Content="查看 I/O 端口" Click="OpenIoPanelButton_Click" />
                                    <Button Content="独立运行判定" FontWeight="SemiBold" Foreground="#0F766E" Click="NumericJudgeRunButton_Click" />
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Visibility="Collapsed">
                                <CheckBox x:Name="EnableShapeToolCheckBox" /><CheckBox x:Name="EnableBlobToolCheckBox" /><CheckBox x:Name="EnableGrayToolCheckBox" /><CheckBox x:Name="EnableEdgeToolCheckBox" /><CheckBox x:Name="EnableHDevToolCheckBox" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="IoTab" Header="I/O" ToolTip="输入/输出">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="9">
                            <Border Background="#263449" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="IoToolTitleText" Text="未选择流程工具" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="IoConnectionStatusText" Text="请在流程区选择工具实例。" Foreground="#C4B5FD" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button x:Name="IoOpenParametersButton" Content="参数" Click="IoOpenParametersButton_Click" />
                                <Button x:Name="IoRunCurrentButton" Content="运行当前" FontWeight="SemiBold" Click="IoRunCurrentButton_Click" />
                                <Button Content="刷新值" Click="IoRefreshButton_Click" />
                            </UniformGrid>

                            <GroupBox Header="输入端口 IN">
                                <ItemsControl x:Name="InputPortsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="PortCard" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="7" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border x:Name="PortBadge" Width="30" Height="30" CornerRadius="15" Background="#FEE2E2" VerticalAlignment="Top">
                                                        <TextBlock Text="IN" FontSize="9" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding DisplayName}" /><Run Text="  (" /><Run Text="{Binding PortName}" /><Run Text=")" /></TextBlock>
                                                        <TextBlock Text="{Binding Source, StringFormat=来源：{0}}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CurrentValue, StringFormat=当前：{0}}" FontSize="10" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <Border Background="#EDE9FE" CornerRadius="8" Padding="6,2"><TextBlock Text="{Binding DataType}" FontSize="9" Foreground="#6D28D9" /></Border>
                                                        <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#B45309" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter TargetName="PortCard" Property="BorderBrush" Value="#86EFAC" />
                                                    <Setter TargetName="PortBadge" Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <GroupBox Header="输出端口 OUT">
                                <ItemsControl x:Name="OutputPortsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="PortCard" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="7" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border x:Name="PortBadge" Width="30" Height="30" CornerRadius="15" Background="#E0E7FF" VerticalAlignment="Top">
                                                        <TextBlock Text="OUT" FontSize="8" FontWeight="Bold" Foreground="#4338CA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding DisplayName}" /><Run Text="  (" /><Run Text="{Binding PortName}" /><Run Text=")" /></TextBlock>
                                                        <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CurrentValue, StringFormat=当前：{0}}" FontSize="10" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <Border Background="#EDE9FE" CornerRadius="8" Padding="6,2"><TextBlock Text="{Binding DataType}" FontSize="9" Foreground="#6D28D9" /></Border>
                                                        <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter TargetName="PortCard" Property="BorderBrush" Value="#86EFAC" />
                                                    <Setter TargetName="PortBadge" Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <GroupBox Header="本次运行摘要">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="输入" /><TextBlock x:Name="InspectorInputSummaryText" Grid.Column="1" Text="--" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Text="输出" /><TextBlock x:Name="InspectorOutputSummaryText" Grid.Row="1" Grid.Column="1" Text="--" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="错误" /><TextBlock x:Name="InspectorErrorText" Grid.Row="2" Grid.Column="1" Text="--" TextWrapping="Wrap" Foreground="#B91C1C" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="RoiTab" Header="图像/ROI">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="9">
                            <GroupBox Header="绘制与视图">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button x:Name="RectangleRoiButton" Content="矩形" Click="RectangleRoiButton_Click" />
                                        <Button x:Name="CircleRoiButton" Content="圆形" Click="CircleRoiButton_Click" />
                                        <Button x:Name="EllipseRoiButton" Content="椭圆" Click="EllipseRoiButton_Click" />
                                        <Button x:Name="AnnulusRoiButton" Content="圆环" Click="AnnulusRoiButton_Click" />
                                        <Button x:Name="RotatedRectangleRoiButton" Content="旋转矩形" Click="RotatedRectangleRoiButton_Click" />
                                        <Button x:Name="LineRoiButton" Content="线" Click="LineRoiButton_Click" />
                                        <Button x:Name="PointRoiButton" Content="点" Click="PointRoiButton_Click" />
                                        <Button x:Name="PolygonRoiButton" Content="多边形" Click="PolygonRoiButton_Click" />
                                        <Button x:Name="ConfirmRoiButton" Content="确认并新增" FontWeight="Bold" Click="ConfirmRoiButton_Click" />
                                        <Button Content="取消绘制" Click="CancelRoiDrawingButton_Click" />
                                        <Button x:Name="FitImageButton" Content="适应窗口" Click="FitImageButton_Click" />
                                    </WrapPanel>
                                    <TextBlock x:Name="RoiStatusText" Text="ROI：未设置" TextWrapping="Wrap" Margin="4" />
                                    <TextBlock Text="每次确认都会新增一个图层，并自动绑定到当前选中的视觉工具。滚轮缩放、右键平移。" Foreground="#64748B" TextWrapping="Wrap" Margin="4" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="选中 ROI 图层">
                                <StackPanel>
                                    <TextBlock x:Name="RoiSelectedLayerText" Text="未选择 ROI 图层" FontWeight="SemiBold" Foreground="#334155" Margin="4" />
                                     <Grid>
                                         <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                         <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                         <TextBlock Text="名称" VerticalAlignment="Center" />
                                         <TextBox x:Name="SelectedRoiLayerNameTextBox" Grid.Column="1" IsEnabled="False" LostFocus="SelectedRoiLayerNameTextBox_LostFocus" />
                                         <TextBlock Grid.Row="1" Text="几何" VerticalAlignment="Center" />
                                         <TextBlock x:Name="SelectedRoiGeometryText" Grid.Row="1" Grid.Column="1" Text="--" Foreground="#64748B" TextWrapping="Wrap" />
                                         <TextBlock Grid.Row="2" Text="保护" VerticalAlignment="Center" />
                                         <CheckBox x:Name="SelectedRoiLockCheckBox" Grid.Row="2" Grid.Column="1" Content="锁定几何与删除" IsEnabled="False" Click="SelectedRoiLockCheckBox_Click" />
                                         <TextBlock Grid.Row="3" Text="角色" VerticalAlignment="Center" />
                                         <TextBlock x:Name="SelectedRoiRoleText" Grid.Row="3" Grid.Column="1" Text="--" Foreground="#BE123C" FontWeight="SemiBold" />
                                     </Grid>
                                     <UniformGrid Columns="4">
                                         <Button x:Name="CopySelectedRoiButton" Content="复制" Click="CopySelectedRoiButton_Click" />
                                         <Button x:Name="ToggleSelectedRoiLockButton" Content="锁定" Click="ToggleSelectedRoiLockButton_Click" />
                                         <Button x:Name="ClearRoiButton" Content="删除选中" Click="ClearRoiButton_Click" />
                                         <Button x:Name="ClearAllRoiLayersButton" Content="清空全部" Click="ClearAllRoiLayersButton_Click" />
                                     </UniformGrid>
                                     <UniformGrid Columns="3">
                                         <Button x:Name="ToggleSelectedRoiRoleButton" Content="设为屏蔽区" Click="ToggleSelectedRoiRoleButton_Click" ToolTip="矩形、圆形、多边形、旋转矩形、椭圆和圆环可作为屏蔽区；线和点不支持" />
                                         <Button x:Name="MoveSelectedRoiUpButton" Content="上移" Click="MoveSelectedRoiUpButton_Click" />
                                         <Button x:Name="MoveSelectedRoiDownButton" Content="下移" Click="MoveSelectedRoiDownButton_Click" />
                                     </UniformGrid>
                                     <TextBlock x:Name="RoiEditGuidanceText" Text="选择模式：单击 ROI 后拖动内部移动，拖动控制点编辑几何。" Foreground="#0F766E" TextWrapping="Wrap" Margin="4" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="ROI 几何属性（草稿）">
                                <StackPanel>
                                    <TextBlock x:Name="RoiGeometryDraftShapeText" Text="选择一个 ROI 后可精确编辑几何参数" FontWeight="SemiBold" Foreground="#334155" Margin="4" TextWrapping="Wrap" />
                                    <StackPanel x:Name="RoiRectangleGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="中心 X（列）" /><TextBox x:Name="RoiRectangleCenterXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="中心 Y（行）" /><TextBox x:Name="RoiRectangleCenterYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="宽度" /><TextBox x:Name="RoiRectangleWidthTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="高度" /><TextBox x:Name="RoiRectangleHeightTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiCircleGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="中心 X（列）" /><TextBox x:Name="RoiCircleCenterXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="中心 Y（行）" /><TextBox x:Name="RoiCircleCenterYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="直径" /><TextBox x:Name="RoiCircleDiameterTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiOrientedGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="中心 X（列）" /><TextBox x:Name="RoiOrientedCenterXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="中心 Y（行）" /><TextBox x:Name="RoiOrientedCenterYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock x:Name="RoiOrientedLength1Label" Text="宽度" /><TextBox x:Name="RoiOrientedLength1TextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock x:Name="RoiOrientedLength2Label" Text="高度" /><TextBox x:Name="RoiOrientedLength2TextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="角度（°）" /><TextBox x:Name="RoiOrientedAngleTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiAnnulusGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="中心 X（列）" /><TextBox x:Name="RoiAnnulusCenterXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="中心 Y（行）" /><TextBox x:Name="RoiAnnulusCenterYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="内径" /><TextBox x:Name="RoiAnnulusInnerDiameterTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="外径" /><TextBox x:Name="RoiAnnulusOuterDiameterTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiLineGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="起点 X（列）" /><TextBox x:Name="RoiLineStartXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="起点 Y（行）" /><TextBox x:Name="RoiLineStartYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="终点 X（列）" /><TextBox x:Name="RoiLineEndXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="终点 Y（行）" /><TextBox x:Name="RoiLineEndYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="长度（只读）" /><TextBox x:Name="RoiLineLengthTextBox" IsReadOnly="True" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="角度（°，只读）" /><TextBox x:Name="RoiLineAngleTextBox" IsReadOnly="True" ToolTip="以图像 X 正方向为 0°，逆时针为正" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiPointGeometryPanel" Visibility="Collapsed">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="2"><TextBlock Text="X（列）" /><TextBox x:Name="RoiPointXTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                            <StackPanel Margin="2"><TextBlock Text="Y（行）" /><TextBox x:Name="RoiPointYTextBox" TextChanged="RoiGeometryDraftValue_Changed" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel x:Name="RoiPolygonGeometryPanel" Visibility="Collapsed">
                                        <TextBlock Text="顶点 X,Y（每行一个；X=列，Y=行）" />
                                        <TextBox x:Name="RoiPolygonVerticesTextBox" MinHeight="76" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="RoiGeometryDraftValue_Changed" />
                                    </StackPanel>
                                    <TextBlock x:Name="RoiGeometryDraftStatusText" Text="选择 ROI 后显示可编辑参数。" Foreground="#64748B" Margin="4" TextWrapping="Wrap" />
                                    <UniformGrid Columns="3">
                                        <Button x:Name="ApplyRoiGeometryDraftButton" Content="应用" IsEnabled="False" Click="ApplyRoiGeometryDraftButton_Click" />
                                        <Button x:Name="CancelRoiGeometryDraftButton" Content="取消" IsEnabled="False" Click="CancelRoiGeometryDraftButton_Click" />
                                        <Button x:Name="ReloadRoiGeometryDraftButton" Content="从图像重载" IsEnabled="False" Click="ReloadRoiGeometryDraftButton_Click" />
                                    </UniformGrid>
                                    <TextBlock Text="输入会在图像区实时预览；只有“应用”才写入配方。锁定 ROI 只读。" Foreground="#64748B" FontSize="10" Margin="4" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="绑定到当前工具">
                                <StackPanel>
                                    <TextBlock x:Name="RoiBindingToolText" Text="请先选择流程中的视觉工具" FontWeight="SemiBold" Foreground="#475569" TextWrapping="Wrap" Margin="4" />
                                    <ItemsControl x:Name="RoiBindingItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsBound}" IsEnabled="{Binding IsCompatible}" VerticalAlignment="Center" Margin="2,0,8,0" Checked="RoiBindingCheckBox_Changed" Unchecked="RoiBindingCheckBox_Changed" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ShapeText}" Foreground="#64748B" FontSize="10" />
                                                            <TextBlock Text="{Binding CompatibilityText}" Foreground="#B45309" FontSize="10" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="#0F766E" FontSize="10" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="RoiBindingsStatusText" Text="绑定后按当前模块的 ROI 执行模式运行。" Foreground="#64748B" TextWrapping="Wrap" Margin="4" />
                                    <Button Content="运行当前工具验证 ROI" FontWeight="SemiBold" Foreground="#0F766E" Click="RunCurrentToolButton_Click" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="模板快捷入口">
                                <StackPanel>
                                    <Button Content="选择 Shape 工具并打开参数" Click="SelectShapeToolButton_Click" />
                                    <TextBlock Text="主要模板参数保留在 Shape Inspector；搜索区域由该工具绑定的 ROI 图层提供。" Foreground="#64748B" TextWrapping="Wrap" Margin="4" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>


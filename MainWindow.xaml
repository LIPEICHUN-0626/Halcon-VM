                                                    <Setter TargetName="PortBadge" Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <GroupBox Header="本次运行摘要">

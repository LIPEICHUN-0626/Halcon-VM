                                                    <DockPanel Margin="0,0,0,4"><TextBlock Text="Unit ID" Width="72" VerticalAlignment="Center" /><TextBox x:Name="TcpTriggerReturnUnitS123" TextChanged="TcpTriggerReturnDraftChangedS123" ToolTip="Modbus TCP 网关的 Unit ID；直连设备也须按设备手册填写" /></DockPanel>
                                                </StackPanel>
                                                <StackPanel x:Name="TcpTriggerReturnRtuFieldsS123" Visibility="Collapsed">
                                                    <DockPanel Margin="0,0,0,4"><TextBlock Text="串口" Width="72" VerticalAlignment="Center" /><TextBox x:Name="TcpTriggerReturnComS123" TextChanged="TcpTriggerReturnDraftChangedS123" ToolTip="例如 COM3；仅回传时打开并释放" /></DockPanel>
                                                    <DockPanel Margin="0,0,0,4"><TextBlock Text="波特率" Width="72" VerticalAlignment="Center" /><TextBox x:Name="TcpTriggerReturnBaudS123" TextChanged="TcpTriggerReturnDraftChangedS123" /></DockPanel>
                                                    <DockPanel Margin="0,0,0,4"><TextBlock Text="站号" Width="72" VerticalAlignment="Center" /><TextBox x:Name="TcpTriggerReturnStationS123" TextChanged="TcpTriggerReturnDraftChangedS123" /></DockPanel>
                                                    <DockPanel Margin="0,0,0,4"><TextBlock Text="校验" Width="72" VerticalAlignment="Center" /><ComboBox x:Name="TcpTriggerReturnParityS123" SelectedValuePath="Tag" SelectionChanged="TcpTriggerReturnDraftChangedS123"><ComboBoxItem Content="偶校验" Tag="Even" /><ComboBoxItem Content="无校验" Tag="None" /><ComboBoxItem Content="奇校验" Tag="Odd" /></ComboBox></DockPanel>
                                                    <DockPanel><TextBlock Text="停止位" Width="72" VerticalAlignment="Center" /><ComboBox x:Name="TcpTriggerReturnStopBitsS123" SelectedValuePath="Tag" SelectionChanged="TcpTriggerReturnDraftChangedS123"><ComboBoxItem Content="1 位" Tag="1" /><ComboBoxItem Content="2 位" Tag="2" /></ComboBox></DockPanel>
                                                </StackPanel>
                                            </StackPanel>

<Window x:Class="HalconWinFormsDemo.HelpCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助中心（中文版）" Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#E9EEF5">
    <Window.Resources>
        <Style TargetType="{x:Type Button}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="2"/></Style>
        <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,6"/><Setter Property="MaxWidth" Value="360"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#263449" Padding="14,9">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" MinWidth="62" Click="CloseButton_Click"/>
                <StackPanel>
                    <TextBlock Text="帮助中心" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="中文版 · 软件操作与模块参考" Foreground="#CBD5E1" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="目录" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Margin="4,2,4,6"/>
                    <TextBox x:Name="HelpSearchTextBox" Grid.Row="1" MinHeight="28" Margin="2,0,2,7" TextChanged="HelpSearchTextBox_TextChanged" ToolTip="搜索界面名称、模块名称、分类、用途或端口类型"/>
                    <ListBox x:Name="HelpTopicList" Grid.Row="2" BorderThickness="0" SelectionChanged="HelpTopicList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="7,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#CBD5E1"/>
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5">
                <FlowDocumentScrollViewer x:Name="HelpDocumentViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False">
                    <FlowDocument x:Name="HelpDocument" PagePadding="30" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#1E293B"/>
                </FlowDocumentScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="HelpStatusText" Text="帮助内容由当前软件真实模块元数据生成。" Foreground="#64748B" FontSize="10"/>
        </Border>
    </Grid>
</Window>

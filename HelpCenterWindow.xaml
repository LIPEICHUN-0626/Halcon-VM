<Window x:Class="HalconWinFormsDemo.HelpCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助中心（中文版）" Width="960" Height="660" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E0F2F1"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#0F766E"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#CCFBF1"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HelpScopeItemUI09" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="#475569"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E2E8F0"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#0F766E"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type ToolTip}"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#334155"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,6"/><Setter Property="MaxWidth" Value="360"/></Style>
    </Window.Resources>
    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#263449" Padding="14,9">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" MinWidth="62" Click="CloseButton_Click"/>
                <StackPanel>
                    <TextBlock Text="帮助中心 · 中文版" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="200" MaxWidth="320"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="340"/></Grid.ColumnDefinitions>
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="目录" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Margin="4,2,4,6"/>
                    <DockPanel Grid.Row="1" Margin="2,0,2,7">
                        <Button x:Name="HelpClearSearchUI10" DockPanel.Dock="Right" Content="×" Visibility="Collapsed" Click="HelpClearSearchUI10_Click" Padding="7,0" ToolTip="清空搜索，保留当前目录范围。" />
                        <Grid>
                            <TextBox x:Name="HelpSearchTextBox" MinHeight="28" Padding="6,3" TextChanged="HelpSearchTextBox_TextChanged" ToolTip="搜索名称、用途或真实端口类型；多个词以空格分隔。"/>
                            <TextBlock Text="搜索模块 / 操作 / 端口" Margin="7,0" VerticalAlignment="Center" Foreground="#94A3B8" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HelpSearchTextBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                    <ListBox x:Name="HelpScopeUI10" Grid.Row="2" SelectedIndex="0" Margin="2,0,2,7" BorderThickness="0" Background="#F1F5F9" ItemContainerStyle="{StaticResource HelpScopeItemUI09}" SelectionChanged="HelpScopeUI10_SelectionChanged" ToolTip="只筛选帮助目录，不添加工具或改变工程。">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBoxItem Content="全部"/><ListBoxItem Content="入门"/><ListBoxItem Content="模块"/>
                    </ListBox>
                    <ListBox x:Name="HelpTopicList" Grid.Row="3" BorderThickness="0" SelectionChanged="HelpTopicList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="7,5" ToolTip="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#CBD5E1"/>
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,5">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="HelpBackUI09" DockPanel.Dock="Left" Content="← 返回" IsEnabled="False" Click="HelpBackUI09_Click" ToolTip="返回上一帮助主题，清空搜索并显示全部目录；不改变方案。"/>
                            <Button x:Name="HelpHomeUI09" DockPanel.Dock="Left" Content="入门首页" Click="HelpHomeUI09_Click" ToolTip="回到六步快速开始。只阅读帮助，不加载示例。"/>
                            <TextBlock x:Name="HelpLocationUI09" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="10,0,3,0" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <DockPanel x:Name="HelpSectionBarUI10" Grid.Row="1" Margin="12,8,12,0" Visibility="Collapsed">
                        <TextBlock Text="本页" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                        <ComboBox x:Name="HelpSectionPickerUI10" MinHeight="26" MaxWidth="260" HorizontalAlignment="Left"
                                  DisplayMemberPath="Title" SelectionChanged="HelpSectionPickerUI10_SelectionChanged"
                                  ToolTip="直接跳到本页的操作步骤、输入或输出。只滚动帮助，不打开模块或改变方案。"/>
                    </DockPanel>
                <FlowDocumentScrollViewer x:Name="HelpDocumentViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False">
                    <FlowDocument x:Name="HelpDocument" PagePadding="18" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#1E293B"/>
                </FlowDocumentScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="HelpStatusText" Text="帮助内容由当前软件真实模块元数据生成。" Foreground="#64748B" FontSize="10"/>
        </Border>
    </Grid>
</Window>

<Window x:Class="HalconWinFormsDemo.ProductionRunHistoryWindowS135"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行周期记录" Width="900" Height="600" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="10,5" /><Setter Property="Margin" Value="3" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#CBD5E1" /><Setter Property="Foreground" Value="#334155" /></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="27" /><Setter Property="Margin" Value="4,2" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#334155" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="#64748B" /><Setter Property="Margin" Value="3" /></Style>
        <Style x:Key="GridTextStyleS135" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Margin" Value="4,3" /></Style>
        <Style TargetType="DataGrid"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D7DEE8" /><Setter Property="RowHeaderWidth" Value="0" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="#EDF2F7" /><Setter Property="HeadersVisibility" Value="Column" /><Setter Property="SelectionMode" Value="Single" /><Setter Property="SelectionUnit" Value="FullRow" /><Setter Property="IsReadOnly" Value="True" /><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="CanUserReorderColumns" Value="False" /></Style>
    </Window.Resources>
    <TabControl x:Name="HistoryTabsS138" Margin="8" Background="#F8FAFC" BorderBrush="#D7DEE8" SelectedIndex="0" SelectionChanged="EvidenceTabS142_Changed">
    <TabItem Header="周期记录">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButtonS135" Content="刷新记录" Click="Refresh_Click" ToolTip="只读重新扫描本地周期记录。不会加载方案、运行算法或重放设备操作。" />
                <Button x:Name="ExportButtonS135" Content="导出筛选范围…" Click="Export_Click" ToolTip="导出当前载入且满足筛选条件的周期，不是全部存储历史；读取警告存在时导出范围可能不完整。" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="运行周期记录" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" />
                <TextBlock x:Name="ModeCaptionS135" Text="明确生产页面的完整周期 · 本地持久记录" FontSize="11" Foreground="#64748B" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D7DEE8" BorderThickness="1" CornerRadius="4" Padding="7" Margin="0,0,0,8">
            <Grid x:Name="FiltersGridS135">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="155" /><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="时间" Style="{StaticResource LabelStyle}" />
                <ComboBox x:Name="TimePickerS135" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="Filter_Changed" ToolTip="滚动最近 24 小时 / 7 日 / 30 日，或当前读取的全部存储范围。时间以周期开始时刻筛选。" />
                <TextBlock Grid.Column="2" Text="方案" Style="{StaticResource LabelStyle}" />
                <ComboBox x:Name="RecipePickerS135" Grid.Column="3" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="Recipe_Changed" ToolTip="以定义 SHA 身份区分方案版本；缺失时回退路径/会话身份，不会把同名方案混合。" />
                <TextBlock Grid.Column="4" Text="流程" Style="{StaticResource LabelStyle}" />
                <ComboBox x:Name="FlowPickerS135" Grid.Column="5" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="Filter_Changed" ToolTip="使用方案身份与稳定 FlowId，不按流程显示名称混同。" />
                <TextBlock Grid.Row="1" Text="终态" Style="{StaticResource LabelStyle}" />
                <ComboBox x:Name="StatePickerS135" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="Filter_Changed" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="来源" Style="{StaticResource LabelStyle}" />
                <ComboBox x:Name="OriginPickerS135" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="Filter_Changed" ToolTip="保留运行开始时记录的来源；未记录来源不能猜成生产。" />
                <CheckBox x:Name="OnlyProductionS135" Grid.Row="2" Grid.ColumnSpan="3" IsChecked="True" Content="仅明确生产周期" Margin="3,5,4,2" VerticalAlignment="Center" Checked="ProductionFilter_Changed" Unchecked="ProductionFilter_Changed" ToolTip="仅明确非模拟的生产页面手动整流程、连续或 TCP 触发；旧记录缺模拟事实归资格未知，取消本项可只读查看。" />
                <ComboBox x:Name="PagePickerS135" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3" DisplayMemberPath="Label" SelectedValuePath="Key" Visibility="Collapsed" SelectionChanged="Filter_Changed" ToolTip="取消仅生产后可查看全部页面或开发记录；这不会把开发运行计为生产。" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="1,0,1,7">
            <TextBlock x:Name="StatisticsTextS135" Text="当前筛选：0 周期 · OK 0 · NG 0 · STOP 0 · TIMEOUT 0 · ERROR 0" FontWeight="SemiBold" Foreground="#0F766E" />
            <TextBlock x:Name="RangeTextS135" Text="时间按本机时区显示；一行是一次完整周期，不是一个算法步骤或一件产品。" FontSize="11" Foreground="#64748B" Margin="0,3,0,0" />
        </StackPanel>
        <DataGrid x:Name="RecordsGridS135" Grid.Row="3" SelectionChanged="Record_Changed" EnableRowVirtualization="True" EnableColumnVirtualization="True" RowHeight="28">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding IdentityTooltip}" /></Style></DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间（本地）" Binding="{Binding LocalTimeText}" SortMemberPath="UtcTime" Width="135" ElementStyle="{StaticResource GridTextStyleS135}" />
                <DataGridTextColumn Header="方案" Binding="{Binding RecipeText}" Width="*" MinWidth="120" ElementStyle="{StaticResource GridTextStyleS135}" />
                <DataGridTextColumn Header="流程" Binding="{Binding FlowText}" Width="*" MinWidth="100" ElementStyle="{StaticResource GridTextStyleS135}" />
                <DataGridTextColumn Header="来源" Binding="{Binding OriginText}" Width="107" ElementStyle="{StaticResource GridTextStyleS135}" />
                <DataGridTemplateColumn Header="终态" SortMemberPath="TerminalState" Width="82">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TerminalState}" Margin="5,3" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#475569" /><Style.Triggers><DataTrigger Binding="{Binding TerminalState}" Value="OK"><Setter Property="Foreground" Value="#15803D" /></DataTrigger><DataTrigger Binding="{Binding TerminalState}" Value="NG"><Setter Property="Foreground" Value="#C2410C" /></DataTrigger><DataTrigger Binding="{Binding TerminalState}" Value="ERROR"><Setter Property="Foreground" Value="#B91C1C" /></DataTrigger><DataTrigger Binding="{Binding TerminalState}" Value="TIMEOUT"><Setter Property="Foreground" Value="#B45309" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="耗时 ms" Binding="{Binding ElapsedText}" SortMemberPath="ElapsedMilliseconds" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
        <Expander x:Name="MoreExpanderS135" Grid.Row="4" Header="更多 · 所选周期详情 / 读取警告" IsExpanded="False" Margin="0,8,0,0" Foreground="#475569">
            <ScrollViewer MaxHeight="185" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="4,5,4,2">
                    <TextBlock x:Name="SelectedIdentityS135" Text="选择周期查看真实身份与步骤；已保存的原图证据可按需查看，不重放运行。" FontSize="11" />
                    <TextBlock x:Name="SelectedReasonS135" Foreground="#9A3412" Margin="0,4,0,5" />
                    <DataGrid x:Name="StepsGridS135" MaxHeight="140" MinHeight="55" Visibility="Collapsed" CanUserSortColumns="False">
                        <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="34" /><DataGridTextColumn Header="模块" Binding="{Binding ToolName}" Width="135" /><DataGridTextColumn Header="结果" Binding="{Binding ResultCode}" Width="70" /><DataGridTextColumn Header="耗时 ms" Binding="{Binding ElapsedMilliseconds, StringFormat=F2}" Width="78" /><DataGridTextColumn Header="本次输出 / 异常" Binding="{Binding DetailText}" Width="*" MinWidth="230" /></DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate><DataTemplate><TextBlock Text="{Binding FullText}" FontSize="11" Margin="8" TextWrapping="Wrap" /></DataTemplate></DataGrid.RowDetailsTemplate>
                    </DataGrid>
                    <TextBlock x:Name="ReadWarningsS135" Foreground="#9A3412" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Expander>
        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" />
            <TextBlock x:Name="StatusTextS135" Text="尚未读取持久记录。" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="1,0,8,0" />
        </DockPanel>
    </Grid>
    </TabItem>
    <TabItem Header="趋势 / 过程">
        <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="TrendExportS138" DockPanel.Dock="Right" Content="导出当前趋势…" Click="TrendExport_ClickS138" ToolTip="冻结点击时的身份、筛选和数值后导出；不重放周期或通讯。" />
                <TextBlock Text="周期趋势" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel x:Name="TrendFiltersS138" Grid.Row="1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                    <TextBlock Text="身份" Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="TrendIdentityS138" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="TrendIdentity_ChangedS138" ToolTip="稳定算法定义 v1 + FlowId；旧记录独立按原始快照 SHA，只能看当时事实，不回填新身份。" />
                    <ComboBox x:Name="TrendScopeS138" Grid.Column="2" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="TrendFilter_ChangedS138" ToolTip="依据执行时的来源、页面和明确模拟事实分组，不从名称猜生产资格。" />
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="125" /><ColumnDefinition Width="135" /></Grid.ColumnDefinitions>
                    <TextBlock Text="数值" Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="TrendMetricS138" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="TrendFilter_ChangedS138" ToolTip="默认耗时；正式 Number 端口按模块、端口、单位及语义严格隔离。最多列出 512 项端口。" />
                    <ComboBox x:Name="TrendCountS138" Grid.Column="2" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="TrendFilter_ChangedS138" />
                    <ComboBox x:Name="TrendTimeS138" Grid.Column="3" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="TrendFilter_ChangedS138" />
                </Grid>
                <CheckBox x:Name="TrendIncludeIncompleteS138" Content="包含未保存 / 草稿 / 截断记录（非批准生产能力）" Margin="4,5,4,7" Checked="TrendInclude_ChangedS138" Unchecked="TrendInclude_ChangedS138" ToolTip="默认排除。勾选仅查看真实事实，不提升记录资格，也不将失败计作业务 NG。" />
            </StackPanel>
            <TextBlock x:Name="TrendStatsS138" Grid.Row="2" Foreground="#0F766E" Margin="3,4,3,8" />
            <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="95" /></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#D7DEE8" BorderThickness="1" Padding="6">
                    <Canvas x:Name="TrendCanvasS138" ClipToBounds="True" Background="White" SizeChanged="TrendCanvas_SizeChangedS138" MouseLeftButtonUp="TrendCanvas_ClickS138" ToolTip="点击曲线位置查看同 RunId 周期。缺失点断开；橙色为业务 NG，红色 ERROR、黄色 TIMEOUT、灰色 STOP 独立显示。" />
                </Border>
                <DataGrid x:Name="TrendPointsS138" Grid.Row="1" Margin="0,7,0,0" SelectionChanged="TrendPoint_ChangedS138" EnableRowVirtualization="True" CanUserSortColumns="False">
                    <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding LocalTime}" Width="125" /><DataGridTextColumn Header="终态" Binding="{Binding State}" Width="75" /><DataGridTextColumn Header="数值" Binding="{Binding ValueText}" Width="120" /><DataGridTextColumn Header="本次数值状态" Binding="{Binding Validity}" Width="*" /></DataGrid.Columns>
                </DataGrid>
            </Grid>
            <TextBlock x:Name="TrendNoteS138" Grid.Row="4" FontSize="11" Foreground="#9A3412" Margin="3,8,3,3" />
            <DockPanel Grid.Row="5" Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="查看所选周期" Click="TrendOpenRecord_ClickS138" ToolTip="只读转到原周期步骤；不会把历史值放回当前工程或按名称猜模块。" />
                <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" />
                <TextBlock x:Name="TrendSelectedS138" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Text="点选曲线或一行查看周期身份。" />
            </DockPanel>
        </Grid>
    </TabItem>
    <TabItem Header="原图证据">
        <Grid Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="所选周期的采集原图" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="EvidenceSummaryS142" Grid.Row="1" Text="先在周期记录页选择周期；不会自动读取历史图。" Foreground="#64748B" FontSize="11" Margin="0,5,0,8" />
            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <Button x:Name="EvidenceOpenButtonS142" DockPanel.Dock="Right" Content="查看所选原图" IsEnabled="False" Click="EvidenceOpenS142_Click"
                        ToolTip="只读取本周期受管文件并核对身份、长度、哈希与像素预算。不重新打开旧 SourcePath，不采相机，不加载到活动图像区。" />
                <ComboBox x:Name="EvidencePickerS142" DisplayMemberPath="Label" SelectionChanged="EvidenceSelectionS142_Changed"
                          ToolTip="{Binding SelectedItem.TechnicalDetail, RelativeSource={RelativeSource Self}}" />
            </DockPanel>
            <Border Grid.Row="3" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" Padding="5">
                <Grid>
                    <Image x:Name="EvidenceImageS142" Stretch="Uniform" IsHitTestVisible="False" />
                    <TextBlock x:Name="EvidenceEmptyS142" Text="显式点击查看；这是独立只读预览。" Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="550" />
                </Grid>
            </Border>
            <Expander Grid.Row="4" Header="更多 · 来源 / 本次身份 / 文件事实" IsExpanded="False" Margin="0,8,0,0" Foreground="#475569">
                <ScrollViewer MaxHeight="115" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="EvidenceDetailS142" FontSize="11" Margin="4" /></ScrollViewer>
            </Expander>
            <DockPanel Grid.Row="5" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" />
                <TextBlock x:Name="EvidenceStatusS142" Text="原图仅是所选图像源在本周期已成功采集的事实，不是失败步骤影像或现场认证。" VerticalAlignment="Center" Foreground="#64748B" FontSize="11" Margin="0,0,8,0" />
            </DockPanel>
        </Grid>
    </TabItem>
    </TabControl>
</Window>
